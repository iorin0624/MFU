from __future__ import annotations

from datetime import datetime
from typing import Any

from flask import Blueprint, current_app, jsonify, render_template, request, session

from .repository import (
    get_version,
    latest_version,
    list_versions,
    record_version,
    update_sync_state,
)
from .service import (
    MailFilterAgentError,
    deploy_script,
    get_mailbox,
    list_mailboxes,
    normalize_mailbox,
    validate_script,
)
from .sieve import SieveRuleError, generate_script, parse_script, script_hash


mail_filters_bp = Blueprint(
    "mail_filters",
    __name__,
    url_prefix="/admin/mail-filters",
    template_folder="templates",
)


def _json_error(message: str, status: int = 400):
    return jsonify({"ok": False, "error": message}), status


def _actor() -> str:
    return str(session.get("user") or "")[:128]


def _serialize_history(rows: list[dict[str, Any]]) -> list[dict[str, Any]]:
    output: list[dict[str, Any]] = []
    for row in rows:
        item = dict(row)
        for key, value in list(item.items()):
            if isinstance(value, datetime):
                item[key] = value.strftime("%Y-%m-%d %H:%M:%S")
        output.append(item)
    return output


def _validate_structured_folder_actions(document: dict[str, Any], folders: list[str]) -> None:
    folder_set = {str(item) for item in folders}
    for rule in document.get("rules") or []:
        if not isinstance(rule, dict) or rule.get("raw") or not rule.get("enabled", True):
            continue
        for action in rule.get("actions") or []:
            if str(action.get("type") or "").lower() != "fileinto":
                continue
            destination = str(action.get("value") or "")
            if destination not in folder_set:
                raise SieveRuleError(
                    f"振り分け先「{destination}」がメールボックスに存在しません。"
                    "フォルダー一覧を再取得してください。"
                )


@mail_filters_bp.before_request
def _require_admin():
    if session.get("user") != "admin":
        return jsonify({"ok": False, "error": "管理者のみアクセス可能です"}), 403
    return None


