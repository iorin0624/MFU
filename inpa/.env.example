# Runtime services use this database account. Migration credentials are kept separately
# in /etc/inpa/migration.env and are never loaded by runtime services.
INPA_ENV=production
INPA_PUBLIC_ORIGIN=https://inpa.mydns.jp
INPA_DATABASE_URL=mysql+pymysql://inpa_app:CHANGE_ME@192.168.103.17/inpa_db?charset=utf8mb4
INPA_SESSION_SECRET=CHANGE_ME
INPA_TOKEN_PEPPER=CHANGE_ME
INPA_MAIL_ENCRYPTION_KEY=CHANGE_ME
INPA_TURNSTILE_SITE_KEY=CHANGE_ME
INPA_TURNSTILE_SECRET_KEY=CHANGE_ME
INPA_SMTP_HOST=CHANGE_ME
INPA_SMTP_PORT=587
INPA_SMTP_USERNAME=CHANGE_ME
INPA_SMTP_PASSWORD=CHANGE_ME
INPA_MAIL_FROM=noreply@inpa.mydns.jp
INPA_SESSION_COOKIE_NAME=inpa_session
INPA_CSRF_COOKIE_NAME=inpa_csrf
INPA_INTERNAL_ADMIN_SOCKET=/run/inpa/admin.sock
INPA_INTERNAL_ADMIN_HMAC_SECRET=CHANGE_ME

