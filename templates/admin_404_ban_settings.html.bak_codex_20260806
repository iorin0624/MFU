{% extends "base.html" %}
{% block title %}自動BAN設定{% endblock %}

{% block content %}
<div class="container mt-4" style="max-width: 920px;">
  <h2 class="mb-3">不審アクセスの自動BAN判定</h2>
  <p class="text-muted">
    秘密ファイル探索と一般的な404探索を別々に判定します。通常のMFU機能が返した404は一般判定に含めません。
  </p>

  <form method="post" class="card card-body shadow-sm">
    <h5 class="mb-3">動作モード</h5>
    <div class="row g-3 align-items-end mb-4">
      <div class="col-md-4">
        <label class="form-label">モード</label>
        <select class="form-select" name="mode">
          <option value="observe" {% if settings.mode == 'observe' %}selected{% endif %}>アプリ判定のみ（一般404はBANしない）</option>
          <option value="enforce" {% if settings.mode == 'enforce' %}selected{% endif %}>アプリの自動BANを実行</option>
        </select>
      </div>
      <div class="col-md-5">
        <label class="form-label">判定のみモードの終了日時</label>
        <input type="datetime-local" class="form-control" name="observe_until" value="{{ settings.observe_until[:16] }}">
        <div class="form-text">終了後は自動的に実行モードへ移行します。空欄なら判定のみを継続します。</div>
      </div>
    </div>

    <div class="alert alert-info py-2">
      Apacheで拒否された秘密ファイル探索は、このモードにかかわらず103.15側で1時間の期限付きBANになります。
    </div>

    <h5 class="mb-3">高危険度パス</h5>
    <p class="small text-muted">.env、認証情報、WordPress、PHPシェル、パストラバーサルなどが対象です。</p>
    <div class="row g-3 align-items-end mb-4">
      <div class="col-md-4">
        <label class="form-label">判定時間（秒）</label>
        <input type="number" class="form-control" name="sensitive_window_sec" min="1" step="1" value="{{ settings.sensitive_window_sec }}" required>
      </div>
      <div class="col-md-4">
        <label class="form-label">何回で判定</label>
        <input type="number" class="form-control" name="sensitive_threshold" min="1" step="1" value="{{ settings.sensitive_threshold }}" required>
      </div>
    </div>

    <h5 class="mb-3">一般404の短時間判定</h5>
    <p class="small text-muted">同一パスの再読込ではなく、異なる存在しないパスの件数で判定します。</p>
    <div class="row g-3 align-items-end mb-4">
      <div class="col-md-4">
        <label class="form-label">判定時間（秒）</label>
        <input type="number" class="form-control" name="short_window_sec" min="0.1" step="0.1" value="{{ settings.short_window_sec }}" required>
      </div>
      <div class="col-md-4">
        <label class="form-label">異なるパス数</label>
        <input type="number" class="form-control" name="short_threshold" min="1" step="1" value="{{ settings.short_threshold }}" required>
      </div>
    </div>

    <h5 class="mb-3">一般404の累積判定</h5>
    <div class="row g-3 align-items-end mb-4">
      <div class="col-md-4">
        <label class="form-label">判定時間（秒）</label>
        <input type="number" class="form-control" name="ip_window_sec" min="1" step="1" value="{{ settings.ip_window_sec }}" required>
      </div>
      <div class="col-md-4">
        <label class="form-label">異なるパス数</label>
        <input type="number" class="form-control" name="ip_threshold" min="1" step="1" value="{{ settings.ip_threshold }}" required>
      </div>
    </div>

    <h5 class="mb-3">BAN期間</h5>
    <div class="row g-3 align-items-end mb-4">
      <div class="col-md-3">
        <label class="form-label">初回（秒）</label>
        <input type="number" class="form-control" name="ban_duration_sec" min="60" max="604800" value="{{ settings.ban_duration_sec }}" required>
      </div>
      <div class="col-md-3">
        <label class="form-label">再検出時（秒）</label>
        <input type="number" class="form-control" name="repeat_ban_duration_sec" min="60" max="604800" value="{{ settings.repeat_ban_duration_sec }}" required>
      </div>
      <div class="col-md-3">
        <label class="form-label">再検出の確認期間（秒）</label>
        <input type="number" class="form-control" name="repeat_window_sec" min="3600" max="31536000" value="{{ settings.repeat_window_sec }}" required>
      </div>
      <div class="col-md-3">
        <label class="form-label">再判定抑止（秒）</label>
        <input type="number" class="form-control" name="cooldown_sec" min="1" value="{{ settings.cooldown_sec }}" required>
      </div>
    </div>

    <div class="row g-3 align-items-end mb-4">
      <div class="col-md-4">
        <label class="form-label">IPv4のBAN単位</label>
        <select class="form-select" name="ipv4_prefix">
          <option value="32" {% if settings.ipv4_prefix == 32 %}selected{% endif %}>/32（推奨・単一IP）</option>
          <option value="24" {% if settings.ipv4_prefix == 24 %}selected{% endif %}>/24（同一ネットワーク全体）</option>
        </select>
      </div>
    </div>

    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-danger">保存</button>
      <a href="{{ url_for('admin_logs') }}" class="btn btn-outline-secondary">ログ画面に戻る</a>
    </div>
  </form>
</div>
{% endblock %}
