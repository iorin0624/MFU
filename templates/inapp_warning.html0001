<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>外部ブラウザで開いてください</title>

  <!-- Bootstrap 5.3.2 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body { background-color: #f8f9fa; }
    .url-text { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace; }
    .tap-hint { font-size: .9rem; }
  </style>
</head>
<body>
  <main class="container py-5">
    <div class="row justify-content-center">
      <div class="col-12 col-md-10 col-lg-8">
        <div class="text-center mb-4">
          <h1 class="h3">📱 外部ブラウザで開いてください</h1>
          <p class="text-muted mb-0">このページは <strong>LINE / Instagram / X（旧Twitter）</strong> などのアプリ内ブラウザでは正常に動作しません。</p>
          <p class="text-muted">下のURLをコピーして <strong>Safari</strong> や <strong>Chrome</strong> などの外部ブラウザで開いてください。</p>
        </div>

        <!-- アプリ内ブラウザ検出アラート（検出できた場合のみ表示） -->
        <div id="inappAlert" class="alert alert-warning d-none" role="alert">
          アプリ内ブラウザを検出しました。外部ブラウザで開き直してください。
        </div>

        <div class="card shadow-sm">
          <div class="card-body">
            <label for="urlInput" class="form-label">アクセス先URL</label>
            <div class="input-group">
              <input id="urlInput" type="text" class="form-control url-text" readonly>
              <button id="copyBtn" class="btn btn-primary" type="button">📋 コピー</button>
            </div>
            <div id="copiedMsg" class="form-text text-success d-none mt-2">✅ コピーしました！</div>

            <hr class="my-4">

            <div class="d-grid gap-2">
              <!-- OSシェアシート -->
              <button id="shareBtn" type="button" class="btn btn-outline-secondary">共有メニューを開く</button>

              <!-- Android Chrome で開く（Chromeがあれば遷移、なければ無視）-->
              <a id="openChromeAndroid" class="btn btn-outline-dark" href="#" role="button">Android で Chrome を試す</a>

              <!-- iOS Chrome で開く（Chromeがあれば遷移、なければ無視）-->
              <a id="openChromeIOS" class="btn btn-outline-dark" href="#" role="button">iOS で Chrome を試す</a>
            </div>

            <p class="text-muted mt-3 tap-hint">
              うまく開けない場合は、URLを <strong>長押しでコピー</strong> → 外部ブラウザを開いて <strong>貼り付け</strong> してください。
            </p>
          </div>
        </div>

      </div>
    </div>
  </main>

  <script>
    (function () {
      const url = window.location.href;
      const urlInput = document.getElementById("urlInput");
      const copyBtn = document.getElementById("copyBtn");
      const copiedMsg = document.getElementById("copiedMsg");
      const shareBtn = document.getElementById("shareBtn");
      const openChromeAndroid = document.getElementById("openChromeAndroid");
      const openChromeIOS = document.getElementById("openChromeIOS");
      const inappAlert = document.getElementById("inappAlert");

      // 1) URL 表示
      urlInput.value = url;

      // 2) クリップボードコピー（フォールバック付き）
      copyBtn.addEventListener("click", async () => {
        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(url);
          } else {
            // フォールバック: 一時textarea
            const ta = document.createElement("textarea");
            ta.value = url;
            ta.style.position = "fixed";
            ta.style.left = "-9999px";
            document.body.appendChild(ta);
            ta.focus();
            ta.select();
            document.execCommand("copy");
            document.body.removeChild(ta);
          }
          copiedMsg.classList.remove("d-none");
          setTimeout(() => copiedMsg.classList.add("d-none"), 2000);
        } catch (e) {
          alert("コピーに失敗しました。手動でコピーしてください。");
        }
      });

      // 3) Web Share API（利用可ならOSの共有メニューを開く）
      shareBtn.addEventListener("click", async () => {
        if (navigator.share) {
          try {
            await navigator.share({ title: document.title, url });
          } catch (e) { /* キャンセル等は無視 */ }
        } else {
          alert("この環境では共有メニューが利用できません。URLをコピーして貼り付けてください。");
        }
      });

      // 4) Chrome スキームでの起動トライ
      //    Android: googlechrome://navigate?url=<URL>
      //    iOS   : googlechrome://<URLのスキームをhttp(s)除去したパス>
      try {
        const encoded = encodeURIComponent(url);
        openChromeAndroid.href = "googlechrome://navigate?url=" + encoded;

        // iOS用：スキーム除去
        const iosTarget = url.replace(/^https?:\/\//i, "");
        openChromeIOS.href = "googlechrome://" + iosTarget;
      } catch (e) {
        // 生成に失敗しても致命的ではないので無視
      }

      // 5) アプリ内ブラウザ検出 + クッキー付与（1日）
      const ua = navigator.userAgent || "";
      const isInApp = /(Line|Instagram|Twitter|FBAN|FBAV)/i.test(ua) || /t\.co\/?/i.test(document.referrer || "");
      if (isInApp) {
        inappAlert.classList.remove("d-none");
      }
      if (isInApp && !document.cookie.includes("InAppView=1")) {
        const expires = new Date(Date.now() + 24 * 60 * 60 * 1000).toUTCString();
        // SameSite=Lax を付与（Secure は https 配下で自動付与推奨）
        document.cookie = "InAppView=1; Path=/; Expires=" + expires + "; SameSite=Lax";
      }
    })();
  </script>

  <!-- （必要なら）Bootstrap JS（今回は不要だが将来の拡張に備えて） -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
