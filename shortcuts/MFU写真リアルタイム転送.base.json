{
  "name": "MFU写真リアルタイム転送",
  "version": 1,
  "note": "iPhoneショートカットを組み立てるための基礎定義です。既存のiPhoneアップロード用APIキーを設定してください。",
  "share_sheet_input": ["images", "media"],
  "variables": {
    "base_url": "https://mfu.iori0624.jp/api/photo-relay/v1",
    "api_key": "PASTE_IOS_UPLOAD_API_KEY_HERE"
  },
  "actions": [
    {"type": "require_input", "source": "shortcut_input", "fallback": "select_photos", "multiple": true},
    {"type": "count", "items": "${shortcut_input}", "save_as": "expected_file_count"},
    {"type": "http", "method": "GET", "url": "${base_url}/devices", "bearer": "${api_key}", "save_as": "device_config"},
    {"type": "choose", "items": "${device_config.devices}", "label_key": "label", "value_key": "device_uuid", "save_as": "device_uuid"},
    {"type": "http", "method": "POST", "url": "${base_url}/jobs", "bearer": "${api_key}", "json": {"device_uuid": "${device_uuid}", "expected_file_count": "${expected_file_count}"}, "save_as": "job"},
    {"type": "repeat", "items": "${shortcut_input}", "actions": [
      {"type": "get_file_detail", "item": "${repeat_item}", "detail": "name", "save_as": "filename"},
      {"type": "get_media_detail", "item": "${repeat_item}", "detail": "date_taken", "save_as": "capture_at_raw"},
      {"type": "format_date", "value": "${capture_at_raw}", "format": "ISO8601", "save_as": "capture_at"},
      {"type": "get_file_detail", "item": "${repeat_item}", "detail": "last_modified", "save_as": "source_modified_at_raw"},
      {"type": "format_date", "value": "${source_modified_at_raw}", "format": "ISO8601", "save_as": "source_modified_at"},
      {"type": "uuid", "save_as": "client_file_id"},
      {"type": "http", "method": "POST", "url": "${base_url}/files", "bearer": "${api_key}", "form": {"job_uuid": "${job.job_uuid}", "client_file_id": "${client_file_id}", "sequence_index": "${repeat_index}", "capture_at": "${capture_at}", "source_modified_at": "${source_modified_at}", "file": "${repeat_item}"}}
    ]},
    {"type": "http", "method": "POST", "url": "${base_url}/jobs/${job.job_uuid}/done", "bearer": "${api_key}", "json": {}, "save_as": "completed"},
    {"type": "if", "condition": "${completed.ok} == false", "actions": [
      {"type": "show_result", "value": "転送未完了\n${completed.message}\n選択: ${completed.expected_count}枚 / 受信: ${completed.uploaded_count}枚"},
      {"type": "stop"}
    ]},
    {"type": "wait", "seconds": 2},
    {"type": "http", "method": "GET", "url": "${base_url}/jobs/${job.job_uuid}", "bearer": "${api_key}", "save_as": "status"},
    {"type": "show_result", "value": "${completed.message}\n保存済み: ${status.completed_files}/${status.total_files}枚\n転送待ち: ${status.pending_files}枚"}
  ]
}
