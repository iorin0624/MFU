    for (const value of [video.currentSrc, video.src, ...Array.from(video.querySelectorAll('source')).map((node) => node.src)]) {{
      if (value && !value.startsWith('blob:') && /cdninstagram\.com/i.test(value) && /(?:\.mp4|\/o1\/v\/)/i.test(value)) {{
