def _delete_entry_operation(data: dict) -> tuple[dict, int]:
    entry_type = str(data.get("type") or "file")
    if catalog.CATALOG_ENABLED:
        try:
            catalog.trash_entry(str(data.get("path") or ""), entry_type)
