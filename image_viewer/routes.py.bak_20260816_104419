    job_id: str = "",
) -> list[dict]:
    _start_instagram_browser()
    target_url = _threads_post_url(identifier, source_url)
    identifier_json = json.dumps(identifier)
    expression = rf"""
(() => {{
  const identifier = {identifier_json};
