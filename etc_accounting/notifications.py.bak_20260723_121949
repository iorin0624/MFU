from __future__ import annotations

import logging
from datetime import datetime

import requests

from app.utils.db import get_db

from .repository import claim_pending_record_notifications, finish_record_notifications


LOGGER = logging.getLogger(__name__)
DISCORD_LIMIT = 2000
ETC_ACCOUNTING_URL = "https://mfu.iori0624.jp/etc-accounting/"


def get_admin_discord_webhook() -> str:
    db = get_db()
    try:
        cur = db.cursor(dictionary=True)
        cur.execute(
            """
            SELECT webhook_url FROM users
            WHERE username='admin' AND webhook_url IS NOT NULL AND webhook_url <> ''
            LIMIT 1
            """
        )
        row = cur.fetchone() or {}
        return str(row.get("webhook_url") or "").strip()
    finally:
        db.close()


def _discord_message(records: list[dict]) -> str:
    total = sum(int(record.get("amount") or 0) for record in records)
    lines = [
        "🚗 ETCの新しい明細を取得しました",
        f"件数: {len(records)}件 / 合計: ¥{total:,}",
        "",
    ]
    shown = 0
    for record in records:
        used_at = record.get("used_at")
        if isinstance(used_at, datetime):
            used_at_text = used_at.strftime("%m/%d %H:%M")
        else:
            used_at_text = str(used_at or "日時不明")
        route = f"{record.get('entry_ic') or '入口記録なし'} → {record.get('exit_ic') or '出口記録なし'}"
        status = "確認中" if "確認中" in str(record.get("remarks") or "") else "確定"
        line = f"• {used_at_text} {route} ¥{int(record.get('amount') or 0):,} [{status}]"
        reserve = len(f"\n…ほか{len(records) - shown}件\n🔗 {ETC_ACCOUNTING_URL}")
        if len("\n".join(lines + [line])) + reserve > DISCORD_LIMIT:
            break
        lines.append(line)
        shown += 1
    if shown < len(records):
        lines.append(f"…ほか{len(records) - shown}件")
    lines.extend(["", f"🔗 {ETC_ACCOUNTING_URL}"])
    return "\n".join(lines)[:DISCORD_LIMIT]


def _post_discord(webhook_url: str, message: str) -> None:
    if not webhook_url:
        raise RuntimeError("管理者のDiscord Webhookが設定されていません。")
    response = requests.post(webhook_url, json={"content": message[:DISCORD_LIMIT]}, timeout=10)
    if not response.ok:
        detail = (response.text or "").replace("\n", " ")[:300]
        raise RuntimeError(f"Discord通知に失敗しました（HTTP {response.status_code}: {detail}）")


def dispatch_pending_new_record_notifications() -> dict:
    records = claim_pending_record_notifications(100)
    if not records:
        return {"status": "empty", "count": 0}
    notification_ids = [int(record["notification_id"]) for record in records]
    try:
        _post_discord(get_admin_discord_webhook(), _discord_message(records))
        finish_record_notifications(notification_ids)
        LOGGER.info("ETC new-record Discord notification sent: count=%s", len(records))
        return {"status": "sent", "count": len(records)}
    except Exception as exc:
        finish_record_notifications(notification_ids, error=str(exc))
        LOGGER.exception("ETC new-record Discord notification failed: count=%s", len(records))
        raise


def send_test_notification() -> None:
    now = datetime.now().strftime("%Y年%m月%d日 %H:%M:%S")
    _post_discord(
        get_admin_discord_webhook(),
        "\n".join([
            "✅ ETC定期取得のDiscordテスト通知です",
            f"送信日時: {now}",
            "新しいETC明細が見つかった場合、このWebhookへ通知します。",
            f"🔗 {ETC_ACCOUNTING_URL}",
        ]),
    )
