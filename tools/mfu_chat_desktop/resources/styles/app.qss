QWidget {
  background: #f6f7f9;
  color: #1f2937;
  font-family: "Yu Gothic UI", "Meiryo", "Segoe UI";
  font-size: 13px;
}

QMainWindow, QDialog {
  background: #f6f7f9;
}

QToolBar {
  background: #ffffff;
  border-bottom: 1px solid #d8dee8;
  spacing: 8px;
}

QSplitter::handle {
  background: #d8dee8;
}

QTabWidget::pane {
  border: 1px solid #d8dee8;
  background: #ffffff;
}

QTabBar::tab {
  background: #eef1f5;
  color: #374151;
  padding: 8px 14px;
  border: 1px solid #d8dee8;
  border-bottom: 0;
}

QTabBar::tab:selected {
  background: #ffffff;
  color: #111827;
}

QListWidget {
  background: #ffffff;
  color: #111827;
  border: 1px solid #d8dee8;
  border-radius: 6px;
  padding: 6px;
}

QListWidget::item {
  padding: 8px;
  border-radius: 5px;
}

QListWidget::item:selected {
  background: #dbeafe;
  color: #0f172a;
}

QTextEdit, QLineEdit {
  background: #ffffff;
  color: #111827;
  border: 1px solid #cfd6df;
  border-radius: 6px;
  padding: 6px;
  selection-background-color: #bfdbfe;
}

QPushButton {
  color: #111827;
  padding: 6px 12px;
  border-radius: 6px;
  border: 1px solid #c7d0da;
  background: #ffffff;
}

QPushButton:hover {
  background: #eef6ff;
}

QPushButton:disabled {
  color: #9ca3af;
  background: #f3f4f6;
}

QMenu {
  background: #ffffff;
  color: #111827;
  border: 1px solid #d8dee8;
}

QMenu::item:selected {
  background: #dbeafe;
}

#chatTitle {
  color: #111827;
  background: transparent;
  font-size: 18px;
  font-weight: 700;
}

#chatTimeline {
  border: 1px solid #d7dcef;
  border-radius: 8px;
  background: #e8f3ff;
}

#chatMessages {
  background: #e8f3ff;
}

#chatDateDivider {
  color: #55606f;
  background: rgba(255,255,255,0.95);
  border-radius: 999px;
  padding: 3px 12px;
  margin-top: 10px;
  margin-bottom: 10px;
  font-size: 12px;
}

#chatAvatar {
  background: #ffffff;
  color: #64748b;
  border: 1px solid rgba(0,0,0,0.08);
  border-radius: 16px;
}

#chatSender {
  color: #667085;
  background: transparent;
  margin-left: 8px;
  margin-bottom: 2px;
  font-size: 12px;
}

#chatBubbleMe {
  background: #4a8dff;
  color: #ffffff;
  border-radius: 16px;
  border-bottom-right-radius: 6px;
}

#chatBubbleOther {
  background: #f1f3f5;
  color: #222222;
  border-radius: 16px;
  border-bottom-left-radius: 6px;
}

#chatBody {
  background: transparent;
  color: inherit;
  line-height: 140%;
}

#chatDeletedText {
  background: transparent;
  color: #7a5260;
  font-style: italic;
}

#chatTime {
  color: #7a7a7a;
  background: transparent;
  font-size: 11px;
}

#chatEditedLabel {
  color: #697187;
  background: transparent;
  font-size: 11px;
}

#chatReplyQuote, #replyPreview {
  color: #445066;
  background: rgba(255,255,255,0.78);
  border-left: 3px solid rgba(68,102,220,0.8);
  border-radius: 10px;
  padding: 6px 8px;
}

#chatReadInline {
  color: #4d5c8f;
  background: transparent;
  font-size: 11px;
}

#chatReactionChip {
  border: 1px solid #d8def8;
  border-radius: 999px;
  font-size: 12px;
  padding: 1px 8px;
  background: rgba(255,255,255,0.92);
}

#threadSummaryButton {
  border: 0;
  color: #3f57b3;
  background: transparent;
  padding: 1px 4px;
  font-size: 12px;
}

#chatImageThumb {
  background: #ffffff;
  border: 1px solid rgba(0,0,0,0.12);
  border-radius: 10px;
  padding: 2px;
}

#typingIndicator {
  color: #5e6780;
  background: rgba(255,255,255,0.92);
  border: 1px solid rgba(0,0,0,0.06);
  border-radius: 999px;
  padding: 6px 10px;
}
