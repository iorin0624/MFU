{% extends "base.html" %}

{% block title %}配送追跡詳細{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h4 mb-0">配送追跡詳細 #{{ target.id }}</h1>
  <a href="{{ url_for('shipment_tracking.shipment_tracking_list') }}" class="btn btn-outline-secondary btn-sm">一覧へ</a>
</div>

{% with messages = get_flashed_messages(with_categories=true) %}
  {% if messages %}
    {% for category, message in messages %}
      <div class="alert alert-{{ 'danger' if category == 'error' else category }}">{{ message }}</div>
    {% endfor %}
  {% endif %}
{% endwith %}

<div class="card mb-3">
  <div class="card-header">基本情報</div>
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">ラベル</dt><dd class="col-sm-9">{{ target.label or '-' }}</dd>
      <dt class="col-sm-3">業者</dt><dd class="col-sm-9">{{ carrier_master.get(target.carrier_code, target.carrier_code) }}</dd>
      <dt class="col-sm-3">配達番号</dt><dd class="col-sm-9">{{ target.tracking_number }}</dd>
      <dt class="col-sm-3">最新状態</dt><dd class="col-sm-9">{{ target.last_current_status or '-' }}</dd>
      <dt class="col-sm-3">最新詳細</dt><dd class="col-sm-9">{{ target.last_current_status_detail or '-' }}</dd>
      <dt class="col-sm-3">最新イベント日時</dt><dd class="col-sm-9">{{ target.last_latest_event_at or '-' }}</dd>
      <dt class="col-sm-3">最終確認日時</dt><dd class="col-sm-9">{{ target.last_checked_at or '-' }}</dd>
      <dt class="col-sm-3">有効状態</dt><dd class="col-sm-9">{{ '有効' if target.is_active else '無効' }}</dd>
      <dt class="col-sm-3">最終エラー</dt><dd class="col-sm-9 text-danger">{{ target.last_error_text or '-' }}</dd>
    </dl>
  </div>
</div>

<div class="mb-3 d-flex gap-2">
  <form method="post" action="{{ url_for('shipment_tracking.shipment_tracking_check_now', id=target.id) }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token_value }}">
    <button type="submit" class="btn btn-primary btn-sm">最新情報の確認</button>
  </form>
  <a href="{{ url_for('shipment_tracking.shipment_tracking_edit', id=target.id) }}" class="btn btn-outline-secondary btn-sm">編集</a>
  <form method="post" action="{{ url_for('shipment_tracking.shipment_tracking_toggle_active', id=target.id) }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token_value }}">
    <button type="submit" class="btn btn-outline-warning btn-sm">有効/無効切替</button>
  </form>
  <form method="post" action="{{ url_for('shipment_tracking.shipment_tracking_test_discord', id=target.id) }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token_value }}">
    <button type="submit" class="btn btn-outline-info btn-sm" onclick="return confirm('現在の配送追跡情報でDiscord通知テストを送信します。よろしいですか？');">Discord通知テスト</button>
  </form>
</div>

<style>
  .tracking-timeline-mobile { display: none; }
  .tracking-detail-lines > * + * { margin-top: .2rem; }
  @media (max-width: 767.98px) {
    .tracking-timeline-desktop { display: none; }
    .tracking-timeline-mobile { display: grid; gap: .75rem; }
    .tracking-event-card { border: 1px solid var(--bs-border-color); border-radius: .75rem; padding: .9rem; }
  }
</style>

<div class="card mb-3">
  <div class="card-header">配送会社の追跡履歴</div>
  <div class="card-body p-0">
    {% if tracking_timeline %}
      <div class="table-responsive tracking-timeline-desktop">
        <table class="table table-sm table-bordered align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th style="width: 19%;">追跡側の日時</th>
              <th style="width: 19%;">MFU確認日時</th>
              <th>詳細</th>
            </tr>
          </thead>
          <tbody>
            {% for event in tracking_timeline %}
              <tr>
                <td class="text-nowrap">{{ event.occurred_at_text }}</td>
                <td class="text-nowrap">{{ event.checked_at_text }}</td>
                <td>
                  <div class="tracking-detail-lines">
                    <div><strong>{{ event.status or '状態不明' }}</strong></div>
                    {% if event.office_name %}<div>{{ event.office_name }}{% if event.office_code %}（{{ event.office_code }}）{% endif %}</div>{% endif %}
                    {% if event.prefecture or event.postal_code %}<div class="text-muted">{{ event.prefecture }}{% if event.postal_code %} 〒{{ event.postal_code }}{% endif %}</div>{% endif %}
                    {% if event.detail %}<div>{{ event.detail }}</div>{% endif %}
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <div class="tracking-timeline-mobile p-3">
        {% for event in tracking_timeline %}
          <article class="tracking-event-card">
            <div class="fw-bold mb-2">{{ event.status or '状態不明' }}</div>
            <dl class="row small mb-0">
              <dt class="col-5">追跡側の日時</dt><dd class="col-7">{{ event.occurred_at_text }}</dd>
              <dt class="col-5">MFU確認日時</dt><dd class="col-7">{{ event.checked_at_text }}</dd>
            </dl>
            {% if event.office_name %}<div>{{ event.office_name }}{% if event.office_code %}（{{ event.office_code }}）{% endif %}</div>{% endif %}
            {% if event.prefecture or event.postal_code %}<div class="small text-muted">{{ event.prefecture }}{% if event.postal_code %} 〒{{ event.postal_code }}{% endif %}</div>{% endif %}
            {% if event.detail %}<div class="mt-2">{{ event.detail }}</div>{% endif %}
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="p-3 text-center text-muted">追跡履歴がありません</div>
    {% endif %}
  </div>
</div>

<details class="card mb-3">
  <summary class="card-header">技術情報・元データを表示</summary>
  <div class="card-body">
    <pre class="mb-0" style="white-space: pre-wrap;">{{ pretty_payload or '(データなし)' }}</pre>
  </div>
</details>

<div class="card">
  <div class="card-header">直近の実行履歴（20件）</div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-sm table-bordered align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>ID</th>
            <th>実行種別</th>
            <th>確認日時</th>
            <th>成功</th>
            <th>変更あり</th>
            <th>状態</th>
            <th>詳細</th>
            <th>エラー</th>
          </tr>
        </thead>
        <tbody>
          {% for row in logs %}
            <tr>
              <td>{{ row.id }}</td>
              <td>{{ row.triggered_by }}</td>
              <td>{{ row.checked_at }}</td>
              <td>{{ '○' if row.success else '×' }}</td>
              <td>{{ '○' if row.changed else '×' }}</td>
              <td>{{ row.current_status or '-' }}</td>
              <td>{{ row.current_status_detail or '-' }}</td>
              <td class="text-danger">{{ row.error_text or '-' }}</td>
            </tr>
          {% else %}
            <tr><td colspan="8" class="text-center text-muted">履歴がありません</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
