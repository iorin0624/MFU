{% extends "base.html" %}

{% block title %}ポップコーン検索 | MFU{% endblock %}

{% block head_extra %}
<style>
  :root {
    --tdr-ink: #172033;
    --tdr-muted: #657085;
    --tdl: #b93a44;
    --tdl-soft: #fff1ed;
    --tds: #176b91;
    --tds-soft: #eaf7fb;
    --card-border: #dfe5ec;
  }
  body { background: #f5f7fa; color: var(--tdr-ink); }
  .container { max-width: 1240px; }
  .tdr-hero {
    border-radius: 24px;
    padding: clamp(1.35rem, 4vw, 2.5rem);
    color: #fff;
    background:
      radial-gradient(circle at 88% 15%, rgba(255,255,255,.22) 0 5%, transparent 5.5%),
      radial-gradient(circle at 78% 70%, rgba(255,255,255,.13) 0 9%, transparent 9.5%),
      linear-gradient(120deg, #7d2934, #176b91);
    box-shadow: 0 16px 42px rgba(20, 45, 70, .18);
  }
  .tdr-hero h1 { font-weight: 800; letter-spacing: .02em; }
  .tdr-hero p { margin: 0; max-width: 780px; color: rgba(255,255,255,.88); }
  .tdr-toolbar {
    background: rgba(255,255,255,.96);
    border: 1px solid var(--card-border);
    border-radius: 20px;
    padding: 1rem;
    box-shadow: 0 8px 28px rgba(28, 49, 74, .08);
  }
  .tdr-segment { display: flex; flex-wrap: wrap; gap: .45rem; }
  .tdr-segment button {
    border: 1px solid #ccd5df;
    color: #405069;
    background: #fff;
    border-radius: 999px;
    padding: .55rem 1rem;
    font-weight: 700;
  }
  .tdr-segment button.active { color: #fff; border-color: #233754; background: #233754; }
  .tdr-segment button[data-value="tdl"].active { background: var(--tdl); border-color: var(--tdl); }
  .tdr-segment button[data-value="tds"].active { background: var(--tds); border-color: var(--tds); }
  .tdr-card {
    height: 100%;
    border: 1px solid var(--card-border);
    border-top: 5px solid #7b8798;
    border-radius: 18px;
    background: #fff;
    overflow: hidden;
    box-shadow: 0 5px 18px rgba(28, 49, 74, .06);
  }
  .tdr-card.park-tdl { border-top-color: var(--tdl); }
  .tdr-card.park-tds { border-top-color: var(--tds); }
  .tdr-card.park-both { border-top-color: #72539d; }
  .tdr-card-body { padding: 1.05rem; }
  .tdr-card h2 { font-size: 1.15rem; font-weight: 800; margin: .55rem 0 .8rem; }
  .tdr-chip {
    display: inline-flex; align-items: center; gap: .25rem;
    padding: .25rem .62rem; border-radius: 999px;
    font-size: .78rem; font-weight: 700; background: #edf1f5; color: #405069;
  }
  .tdr-chip.tdl { background: var(--tdl-soft); color: #9c2633; }
  .tdr-chip.tds { background: var(--tds-soft); color: #075d83; }
  .tdr-chip.new { background: #ffe7e7; color: #c22032; }
  .tdr-chip.bb { background: #f0eafe; color: #65439a; }
  .offer { padding: .75rem 0; border-top: 1px solid #edf0f4; }
  .offer:first-of-type { border-top: 0; }
  .offer-area { color: var(--tdr-muted); font-size: .8rem; font-weight: 700; }
  .offer-name { font-size: .94rem; font-weight: 700; }
  .time-note { color: #9a4e00; background: #fff4d9; border-radius: 8px; padding: .36rem .5rem; font-size: .8rem; margin-top: .4rem; }
  .bucket-placeholder {
    display: grid; place-items: center; min-height: 120px;
    background: linear-gradient(135deg, #f0f3f7, #e5ebf2);
    font-size: 3.3rem;
  }
  .price { font-size: 1.25rem; font-weight: 800; }
  .product-offers { max-height: 270px; overflow: auto; padding-right: .25rem; }
  .update-strip { color: var(--tdr-muted); font-size: .85rem; }
  .comparison-wrap { background: #fff; border: 1px solid var(--card-border); border-radius: 18px; overflow: hidden; }
  .comparison-wrap th { background: #eef2f7; }
  .park-mark { font-weight: 800; font-size: 1.1rem; }
  .park-mark.yes { color: #15814f; }
  .park-mark.no { color: #a9b1bd; }
  .official-note { border-left: 4px solid #7b8798; background: #fff; }
  #noResults { border: 1px dashed #aeb8c5; border-radius: 16px; color: var(--tdr-muted); }
  @media (max-width: 575.98px) {
    .tdr-hero { border-radius: 16px; }
    .tdr-toolbar { border-radius: 14px; }
    .tdr-segment button { flex: 1 1 auto; padding-inline: .7rem; }
  }
</style>
{% endblock %}

{% block content %}
<header class="tdr-hero mb-4">
  <div class="small fw-bold text-uppercase mb-2">Tokyo Disney Resort information</div>
  <h1 class="h2 mb-2">🍿 ポップコーン検索</h1>
  <p>東京ディズニーランドと東京ディズニーシーの味・販売場所・バケット商品を、ひとつの画面で確認できます。</p>
</header>

{% if not snapshot %}
  <div class="alert alert-info py-4">
    <h2 class="h5">現在、情報を準備しています</h2>
    <p class="mb-0">最初の公式情報取得が完了すると、こちらに一覧が表示されます。</p>
  </div>
{% else %}
  <section class="tdr-toolbar mb-4" aria-label="検索と絞り込み">
    <div class="row g-3 align-items-end">
      <div class="col-12">
        <div class="small fw-bold text-secondary mb-2">パーク</div>
        <div class="tdr-segment" id="parkFilter">
          <button type="button" class="active" data-value="all">両パーク</button>
          <button type="button" data-value="tdl">ディズニーランド</button>
          <button type="button" data-value="tds">ディズニーシー</button>
        </div>
      </div>
      <div class="col-12">
        <div class="small fw-bold text-secondary mb-2">表示</div>
        <div class="tdr-segment" id="viewFilter">
          <button type="button" class="active" data-value="flavor">味から探す</button>
          <button type="button" data-value="product">バケットから探す</button>
          <button type="button" data-value="compare">パーク比較</button>
        </div>
      </div>
      <div class="col-12 col-lg-5">
        <label class="form-label small fw-bold" for="tdrSearch">キーワード</label>
        <input id="tdrSearch" class="form-control" type="search" placeholder="味・エリア・販売場所・商品IDを検索">
      </div>
      <div class="col-6 col-lg-3">
        <label class="form-label small fw-bold" for="areaFilter">エリア</label>
        <select id="areaFilter" class="form-select">
          <option value="all">すべて</option>
          {% for area in areas %}<option value="{{ area }}">{{ area }}</option>{% endfor %}
        </select>
      </div>
      <div class="col-6 col-lg-2">
        <label class="form-label small fw-bold" for="typeFilter">種類</label>
        <select id="typeFilter" class="form-select">
          <option value="all">すべて</option>
          <option value="regular">通常</option>
          <option value="bb">BB</option>
        </select>
      </div>
      <div class="col-12 col-lg-2 product-filter d-none">
        <label class="form-label small fw-bold" for="statusFilter">商品</label>
        <select id="statusFilter" class="form-select">
          <option value="all">すべて</option>
          <option value="new">NEW</option>
          <option value="limited">期間記載あり</option>
        </select>
      </div>
    </div>
  </section>

  <div class="d-flex flex-wrap justify-content-between gap-2 align-items-center mb-3 update-strip">
    <span><strong id="visibleCount">0</strong>件を表示</span>
    <span>最終更新：{{ snapshot.fetched_at.strftime('%Y年%m月%d日 %H:%M') if snapshot.fetched_at else data.fetched_at }}</span>
  </div>

  <section id="flavorView" class="row g-3">
    {% for row in data.flavors %}
      <article class="col-12 col-md-6 col-xl-4 filter-card"
               data-kind="flavor" data-parks="{{ row.park }}" data-type="{{ row.popcorn_type }}"
               data-area="{{ row.offers | map(attribute='area') | join(' ') }}"
               data-search="{{ row.name }} {{ row.offers | map(attribute='area') | join(' ') }} {{ row.offers | map(attribute='location') | join(' ') }}">
        <div class="tdr-card park-{{ row.park }}">
          <div class="tdr-card-body">
            <div class="d-flex flex-wrap gap-2">
              <span class="tdr-chip {{ row.park }}">{{ 'TDL' if row.park == 'tdl' else 'TDS' }}</span>
              {% if row.popcorn_type == 'bb' %}<span class="tdr-chip bb">BBポップコーン</span>{% endif %}
            </div>
            <h2>{{ row.name }}</h2>
            {% for offer in row.offers %}
              <div class="offer">
                <div class="offer-area">{{ offer.area }}</div>
                <div class="offer-name">{{ offer.location }}</div>
                {% if offer.time_note %}<div class="time-note">⏰ {{ offer.time_note }}</div>{% endif %}
                {% if offer.official_url %}<a href="{{ offer.official_url }}" target="_blank" rel="noopener noreferrer" class="small">公式で場所を見る ↗</a>{% endif %}
              </div>
            {% endfor %}
          </div>
        </div>
      </article>
    {% endfor %}
  </section>

  <section id="productView" class="row g-3 d-none">
    {% for product in data.products %}
      {% set park_class = product.parks[0] if product.parks|length == 1 else 'both' %}
      <article class="col-12 col-md-6 col-xl-4 filter-card"
               data-kind="product" data-parks="{{ product.parks | join(' ') }}" data-type="{{ product.popcorn_type }}"
               data-status="{% if product.is_new %}new {% endif %}{% if product.offers | selectattr('period') | list %}limited{% endif %}"
               data-area="{{ product.offers | map(attribute='area') | join(' ') }}"
               data-search="{{ product.id }} {{ product.title }} {{ product.offers | map(attribute='flavor') | join(' ') }} {{ product.offers | map(attribute='area') | join(' ') }} {{ product.offers | map(attribute='location') | join(' ') }}">
        <div class="tdr-card park-{{ park_class }}">
          <div class="bucket-placeholder" aria-hidden="true">🍿</div>
          <div class="tdr-card-body">
            <div class="d-flex flex-wrap gap-2">
              {% for park in product.parks %}<span class="tdr-chip {{ park }}">{{ park|upper }}</span>{% endfor %}
              {% if product.is_new %}<span class="tdr-chip new">NEW</span>{% endif %}
              {% if product.popcorn_type == 'bb' %}<span class="tdr-chip bb">BB</span>{% endif %}
            </div>
            <h2>{{ product.title }}</h2>
            <div class="d-flex justify-content-between align-items-baseline mb-2">
              <span class="price">¥{{ '{:,}'.format(product.price) }}</span>
              {% if product.id_is_official | default(true) %}<span class="text-secondary small">商品ID {{ product.id }}</span>{% endif %}
            </div>
            {% if product.notice %}<p class="small text-warning-emphasis mb-2">{{ product.notice }}</p>{% endif %}
            <div class="product-offers">
              {% for offer in product.offers %}
                <div class="offer">
                  <div class="d-flex gap-2 mb-1"><span class="tdr-chip {{ offer.park }}">{{ offer.park|upper }}</span><strong>{{ offer.flavor }}</strong></div>
                  <div class="offer-area">{{ offer.area }}</div>
                  <div class="offer-name">{{ offer.location }}</div>
                  {% if offer.period %}<div class="small text-secondary mt-1">販売期間：{{ offer.period }}</div>{% endif %}
                  {% if offer.time_note %}<div class="time-note">⏰ {{ offer.time_note }}</div>{% endif %}
                </div>
              {% endfor %}
            </div>
            <a href="{{ product.image_url or product.official_url }}" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="btn btn-outline-primary w-100 mt-3">デザインを公式で確認 ↗</a>
          </div>
        </div>
      </article>
    {% endfor %}
  </section>

  <section id="compareView" class="d-none">
    <div class="comparison-wrap table-responsive">
      <table class="table align-middle mb-0">
        <thead><tr><th>味</th><th class="text-center">TDL</th><th class="text-center">TDS</th><th>種類</th></tr></thead>
        <tbody>
        {% for row in comparison %}
          <tr class="comparison-row" data-search="{{ row.name }}" data-parks="{% if row.tdl %}tdl {% endif %}{% if row.tds %}tds{% endif %}" data-type="{{ row.popcorn_type }}">
            <td class="fw-bold">{{ row.name }}</td>
            <td class="text-center park-mark {{ 'yes' if row.tdl else 'no' }}">{{ '●' if row.tdl else '―' }}</td>
            <td class="text-center park-mark {{ 'yes' if row.tds else 'no' }}">{{ '●' if row.tds else '―' }}</td>
            <td>{{ 'BBポップコーン' if row.popcorn_type == 'bb' else '通常' }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <div id="noResults" class="d-none text-center py-5 my-3">条件に一致する情報がありません。</div>
{% endif %}

<aside class="official-note rounded-3 p-3 my-4 small text-secondary">
  <strong class="text-dark">非公式の情報整理ページです。</strong>
  本ページは東京ディズニーリゾート公式サイトの事実情報を整理して表示しています。営業時間、販売期間、価格、休止情報などは予告なく変更される場合があります。来園前に
  <a href="https://www.tokyodisneyresort.jp/tdl/food/popcorn.html" target="_blank" rel="noopener noreferrer">TDL公式</a>・
  <a href="https://www.tokyodisneyresort.jp/tds/food/popcorn.html" target="_blank" rel="noopener noreferrer">TDS公式</a>をご確認ください。
</aside>
{% endblock %}

{% block body_extra %}
{% if snapshot %}
<script>
(() => {
  let park = 'all';
  let view = 'flavor';
  const search = document.getElementById('tdrSearch');
  const area = document.getElementById('areaFilter');
  const type = document.getElementById('typeFilter');
  const status = document.getElementById('statusFilter');
  const count = document.getElementById('visibleCount');
  const noResults = document.getElementById('noResults');
  const normalize = value => String(value || '').toLocaleLowerCase('ja').replace(/\s+/g, ' ').trim();

  const selectSegment = (rootId, callback) => {
    document.querySelectorAll(`#${rootId} button`).forEach(button => {
      button.addEventListener('click', () => {
        document.querySelectorAll(`#${rootId} button`).forEach(item => item.classList.remove('active'));
        button.classList.add('active');
        callback(button.dataset.value);
        applyFilters();
      });
    });
  };

  const matchCommon = element => {
    const parks = (element.dataset.parks || '').split(/\s+/);
    if (park !== 'all' && !parks.includes(park)) return false;
    if (type.value !== 'all' && element.dataset.type !== type.value) return false;
    if (view !== 'compare' && area.value !== 'all' && !(element.dataset.area || '').includes(area.value)) return false;
    const query = normalize(search.value);
    return !query || normalize(element.dataset.search).includes(query);
  };

  function applyFilters() {
    document.getElementById('flavorView').classList.toggle('d-none', view !== 'flavor');
    document.getElementById('productView').classList.toggle('d-none', view !== 'product');
    document.getElementById('compareView').classList.toggle('d-none', view !== 'compare');
    document.querySelectorAll('.product-filter').forEach(el => el.classList.toggle('d-none', view !== 'product'));
    area.closest('.col-6').classList.toggle('d-none', view === 'compare');
    let visible = 0;
    document.querySelectorAll('.filter-card').forEach(card => {
      let show = card.dataset.kind === view && matchCommon(card);
      if (show && view === 'product' && status.value !== 'all') {
        show = (card.dataset.status || '').split(/\s+/).includes(status.value);
      }
      card.classList.toggle('d-none', !show);
      if (show) visible += 1;
    });
    document.querySelectorAll('.comparison-row').forEach(row => {
      const show = view === 'compare' && matchCommon(row);
      row.classList.toggle('d-none', !show);
      if (show) visible += 1;
    });
    count.textContent = String(visible);
    noResults.classList.toggle('d-none', visible !== 0);
  }

  selectSegment('parkFilter', value => { park = value; });
  selectSegment('viewFilter', value => { view = value; });
  [search, area, type, status].forEach(el => el.addEventListener(el === search ? 'input' : 'change', applyFilters));
  applyFilters();
})();
</script>
{% endif %}
{% endblock %}
