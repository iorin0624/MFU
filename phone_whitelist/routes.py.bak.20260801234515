def click_to_call_status(job_id: str):
    if not re.fullmatch(r"[a-f0-9]{32}", job_id):
        abort(404)
    db = get_db()
    try:
        cur = db.cursor(dictionary=True)
        cur.execute(
            """
            SELECT job_id, phone_number, endpoint, endpoint_name, trunk_key, trunk_name,
                   status, detail, created_at, updated_at, answered_at, connected_at, ended_at,
                   terminal_audited
              FROM phone_click_to_call_jobs WHERE job_id=%s
            """,
            (job_id,),
        )
        job = cur.fetchone()
        if not job:
            abort(404)
        if job["status"] in CLICK_TO_CALL_TERMINAL_STATUSES and not job["terminal_audited"]:
            cur.execute(
                "UPDATE phone_click_to_call_jobs SET terminal_audited=1 "
                "WHERE job_id=%s AND terminal_audited=0",
