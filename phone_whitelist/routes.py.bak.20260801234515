            db.close()


def _until_epoch(value: datetime | None) -> int:
    if not value:
        return 0
    if value.year >= 2099:
        return MANUAL_EPOCH
    aware = value.replace(tzinfo=JST) if value.tzinfo is None else value.astimezone(JST)
    return max(0, int(aware.timestamp()))


