def _click_to_call_pbx(job_id: str, payload: dict[str, str]) -> dict[str, Any]:
    command = [
        "/usr/bin/ssh", "-T", "-i", PBX_KEY_PATH,
        "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes",
        "-o", "StrictHostKeyChecking=yes",
        "-o", f"UserKnownHostsFile={PBX_KNOWN_HOSTS}",
        "-o", "ConnectTimeout=5", f"{PBX_USER}@{PBX_HOST}",
        "click-to-call", "start", job_id,
    ]
    try:
        result = subprocess.run(
            command,
            input=json.dumps(payload, ensure_ascii=False, separators=(",", ":")),
            text=True,
            capture_output=True,
            timeout=PBX_TIMEOUT_SECONDS,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise PhoneWhitelistError(f"FreePBXの発信処理に接続できません: {exc}") from exc
    if result.returncode != 0:
        message = (result.stderr or result.stdout or "FreePBXの発信処理に失敗しました").strip()
        raise PhoneWhitelistError(message[:500])
    try:
        response = json.loads((result.stdout or "").strip())
    except json.JSONDecodeError as exc:
        raise PhoneWhitelistError("FreePBXから不正な応答を受信しました") from exc
    if not isinstance(response, dict) or not response.get("ok"):
        raise PhoneWhitelistError(str(response.get("error") if isinstance(response, dict) else response)[:500])
    return response


