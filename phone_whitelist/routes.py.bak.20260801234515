@phone_whitelist_bp.post("/internal/phone-click-to-call/status")
def click_to_call_internal_status():
    if request.content_length is not None and request.content_length > 4096:
        abort(413)
    allowed = {
        item.strip()
        for item in os.getenv("PHONE_CLICK_TO_CALL_ALLOWED_IPS", "192.168.103.21,127.0.0.1").split(",")
        if item.strip()
    }
    if request.remote_addr not in allowed:
        abort(403)
    body = request.get_data(cache=True)
    if len(body) > 4096:
        abort(413)
    timestamp = request.headers.get("X-MFU-Timestamp", "")
    signature = request.headers.get("X-MFU-Signature", "").strip().lower()
    secret = _click_to_call_secret()
    if not secret or not re.fullmatch(r"\d{10,12}", timestamp):
        abort(403)
    if abs(int(time.time()) - int(timestamp)) > 300:
        abort(403)
    expected = hmac.new(
        secret.encode("utf-8"), timestamp.encode("ascii") + b"." + body, hashlib.sha256,
    ).hexdigest()
    if not re.fullmatch(r"[0-9a-f]{64}", signature) or not hmac.compare_digest(expected, signature):
        abort(403)
    try:
        payload = json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return jsonify({"ok": False, "message": "JSONが不正です"}), 400
    job_id = str(payload.get("job_id") or "")
    status = str(payload.get("status") or "")
    detail = str(payload.get("detail") or "")[:255]
    if not re.fullmatch(r"[a-f0-9]{32}", job_id) or status not in CLICK_TO_CALL_STATUS_LABELS:
        return jsonify({"ok": False, "message": "状態通知が不正です"}), 400

    db = get_db()
    try:
        cur = db.cursor(dictionary=True)
        cur.execute("SELECT status FROM phone_click_to_call_jobs WHERE job_id=%s FOR UPDATE", (job_id,))
        current = cur.fetchone()
        if not current:
            return jsonify({"ok": False, "message": "ジョブが見つかりません"}), 404
        if current["status"] in CLICK_TO_CALL_TERMINAL_STATUSES:
            db.commit()
            return jsonify({"ok": True, "status": current["status"]})
        if (
            status in CLICK_TO_CALL_STATUS_ORDER
            and CLICK_TO_CALL_STATUS_ORDER.get(current["status"], -1) > CLICK_TO_CALL_STATUS_ORDER[status]
        ):
            db.commit()
            return jsonify({"ok": True, "status": current["status"]})
        timestamp_updates = {
            "phone_answered": "answered_at=COALESCE(answered_at,NOW())",
            "call_started": "connected_at=COALESCE(connected_at,NOW())",
            "phone_no_answer": "ended_at=COALESCE(ended_at,NOW())",
            "external_failed": "ended_at=COALESCE(ended_at,NOW())",
            "call_ended": "ended_at=COALESCE(ended_at,NOW())",
            "failed": "ended_at=COALESCE(ended_at,NOW())",
        }
        extra_update = timestamp_updates.get(status)
        sql = "UPDATE phone_click_to_call_jobs SET status=%s, detail=%s"
        if extra_update:
            sql += f", {extra_update}"
        sql += " WHERE job_id=%s"
        cur.execute(sql, (status, detail, job_id))
        db.commit()
        return jsonify({"ok": True, "status": status})
    finally:
        db.close()


