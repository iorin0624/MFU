def _public_register_inspect(list_type: str):
    audit_prefix = f"{list_type}_token"
    if not _same_origin_public_request():
        return _public_json_error("アクセス元を確認できません", 403)
    token = str((request.get_json(silent=True) or {}).get("token") or "")
    fingerprint = token_fingerprint(token)
    try:
        _enforce_public_rate_limit()
        claims = _validated_public_token(token)
        db = get_db()
        try:
            cur = db.cursor(dictionary=True)
            cur.execute("SELECT outcome FROM phone_blacklist_action_tokens WHERE token_hash=%s", (fingerprint,))
            if cur.fetchone() is not None:
                raise ActionTokenUsedError("このリンクは使用済みです")
        finally:
            db.close()
        _audit(
            f"{audit_prefix}_inspect",
            "ok",
            {"token_hash_prefix": fingerprint[:12], "phone_number": claims.phone_number},
        )
        return jsonify(
            {
                "ok": True,
                "phone_number": claims.phone_number,
                "expires_at": _token_datetime(claims.expires_at).isoformat(sep=" "),
            }
        )
    except ActionTokenExpired as exc:
        _audit(f"{audit_prefix}_inspect", "error", {"token_hash_prefix": fingerprint[:12]}, "expired")
        return _public_json_error(str(exc), 410)
    except ActionTokenUsedError as exc:
        _audit(f"{audit_prefix}_inspect", "error", {"token_hash_prefix": fingerprint[:12]}, "used")
        return _public_json_error(str(exc), 409)
    except PublicRateLimitError as exc:
        _audit(f"{audit_prefix}_rate_limit", "error", {"token_hash_prefix": fingerprint[:12]}, "limited")
        return _public_json_error(str(exc), 429)
    except ActionTokenError:
        _audit(f"{audit_prefix}_inspect", "error", {"token_hash_prefix": fingerprint[:12]}, "invalid")
        return _public_json_error("このリンクは無効です", 403)
    except PhoneWhitelistError as exc:
        _audit(f"{audit_prefix}_inspect", "error", {"token_hash_prefix": fingerprint[:12]}, str(exc))
        return _public_json_error("登録リンク機能を利用できません", 503)


