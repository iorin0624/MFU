@phone_whitelist_bp.post("/phone-blacklist/register/apply")
def public_blacklist_register_apply():
    if not _same_origin_public_request():
        return _public_json_error("アクセス元を確認できません", 403)
    payload = request.get_json(silent=True) or {}
    token = str(payload.get("token") or "")
    fingerprint = token_fingerprint(token)
    try:
        _enforce_public_rate_limit()
        claims = _validated_public_token(token)
        entry = validate_entry(claims.phone_number, payload.get("name"), payload.get("note"))
        issued_at = _token_datetime(claims.issued_at)
        expires_at = _token_datetime(claims.expires_at)

        def change(cur):
            cur.execute(
                "SELECT outcome FROM phone_blacklist_action_tokens WHERE token_hash=%s FOR UPDATE",
                (fingerprint,),
            )
            if cur.fetchone() is not None:
                raise ActionTokenUsedError("このリンクは使用済みです")
            cur.execute(
                "SELECT id, phone_number, name, note FROM phone_blacklist_entries WHERE phone_number=%s",
                (entry["phone_number"],),
            )
            existing = cur.fetchone()
            outcome = "already_registered" if existing else "registered"
            cur.execute(
                """
                INSERT INTO phone_blacklist_action_tokens
                    (token_hash, phone_number, issued_at, expires_at, used_at, used_ip, outcome)
                VALUES (%s, %s, %s, %s, NOW(), %s, %s)
                """,
                (fingerprint, entry["phone_number"], issued_at, expires_at, _client_ip(), outcome),
            )
            if not existing:
                cur.execute(
                    "INSERT INTO phone_blacklist_entries (phone_number, name, note) VALUES (%s, %s, %s)",
                    (entry["phone_number"], entry["name"], entry["note"]),
                )
            cur.execute("SELECT 1 FROM phone_whitelist_entries WHERE phone_number=%s", (entry["phone_number"],))
            return {
                "after": entry,
                "already_registered": bool(existing),
                "whitelist_overlap": cur.fetchone() is not None,
                "token_hash_prefix": fingerprint[:12],
            }

        details, _count = _run_locked_change(change, "discord-token")
        _audit("blacklist_token_apply", "ok", details)
        if details["already_registered"]:
            message = "この電話番号は既にブラックリストへ登録されています。"
        elif details["whitelist_overlap"]:
            message = "ブラックリストへ登録しました。ホワイトリストにも登録されていますが、ブラックリストが優先されます。"
        else:
            message = "ブラックリストへ登録し、FreePBXへ反映しました。"
        return jsonify({"ok": True, "message": message})
    except ActionTokenExpired as exc:
        _audit("blacklist_token_apply", "error", {"token_hash_prefix": fingerprint[:12]}, "expired")
        return _public_json_error(str(exc), 410)
    except ActionTokenUsedError as exc:
        _audit("blacklist_token_apply", "error", {"token_hash_prefix": fingerprint[:12]}, "used")
