    except ActionTokenExpired as exc:
        _audit("whitelist_token_apply", "error", {"token_hash_prefix": fingerprint[:12]}, "expired")
        return _public_json_error(str(exc), 410)
    except ActionTokenUsedError as exc:
        _audit("whitelist_token_apply", "error", {"token_hash_prefix": fingerprint[:12]}, "used")
        return _public_json_error(str(exc), 409)
    except PublicRateLimitError as exc:
        _audit("whitelist_token_rate_limit", "error", {"token_hash_prefix": fingerprint[:12]}, "limited")
        return _public_json_error(str(exc), 429)
    except ActionTokenError:
        _audit("whitelist_token_apply", "error", {"token_hash_prefix": fingerprint[:12]}, "invalid")
        return _public_json_error("このリンクは無効です", 403)
    except WhitelistValidationError as exc:
        _audit("whitelist_token_apply", "error", {"token_hash_prefix": fingerprint[:12]}, str(exc))
        return _public_json_error(str(exc), 400)
    except IntegrityError:
