def public_whitelist_register_apply():
    if not _same_origin_public_request():
        return _public_json_error("アクセス元を確認できません", 403)
    payload = request.get_json(silent=True) or {}
    token = str(payload.get("token") or "")
    fingerprint = token_fingerprint(token)
    try:
        _enforce_public_rate_limit()
        claims = _validated_public_token(token)
        entry = validate_entry(claims.phone_number, payload.get("name"), payload.get("note"))
        issued_at = _token_datetime(claims.issued_at)
        expires_at = _token_datetime(claims.expires_at)

        def change(cur):
            cur.execute(
                "SELECT outcome FROM phone_blacklist_action_tokens WHERE token_hash=%s FOR UPDATE",
                (fingerprint,),
            )
            if cur.fetchone() is not None:
                raise ActionTokenUsedError("このリンクは使用済みです")
            cur.execute(
                "SELECT id FROM phone_blacklist_entries WHERE phone_number=%s",
                (entry["phone_number"],),
            )
            blacklisted = cur.fetchone() is not None
            cur.execute(
                "SELECT id, phone_number, name, note FROM phone_whitelist_entries WHERE phone_number=%s",
                (entry["phone_number"],),
            )
            existing = cur.fetchone()
            if blacklisted:
                outcome = "rejected_blacklisted"
            elif existing:
                outcome = "already_registered"
            else:
                outcome = "registered"
            cur.execute(
                """
                INSERT INTO phone_blacklist_action_tokens
                    (token_hash, phone_number, issued_at, expires_at, used_at, used_ip, outcome)
                VALUES (%s, %s, %s, %s, NOW(), %s, %s)
                """,
                (fingerprint, entry["phone_number"], issued_at, expires_at, _client_ip(), outcome),
            )
            if not blacklisted and not existing:
                cur.execute(
                    "INSERT INTO phone_whitelist_entries (phone_number, name, note) VALUES (%s, %s, %s)",
                    (entry["phone_number"], entry["name"], entry["note"]),
                )
            return {
                "after": entry,
                "already_registered": bool(existing),
                "blacklisted": blacklisted,
                "token_hash_prefix": fingerprint[:12],
