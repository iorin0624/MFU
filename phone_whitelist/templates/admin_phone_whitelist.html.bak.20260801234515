{% extends "base.html" %}
{% block title %}着信リスト管理 | MFU{% endblock %}

{% block content %}
{% set is_blacklist = list_type == 'blacklist' %}
{% set list_name = 'ブラックリスト' if is_blacklist else 'ホワイトリスト' %}
{% set export_endpoint = 'phone_whitelist.export_blacklist_csv' if is_blacklist else 'phone_whitelist.export_csv' %}
{% set add_endpoint = 'phone_whitelist.add_blacklist_entry' if is_blacklist else 'phone_whitelist.add_entry' %}
{% set edit_endpoint = 'phone_whitelist.edit_blacklist_entry' if is_blacklist else 'phone_whitelist.edit_entry' %}
{% set delete_endpoint = 'phone_whitelist.delete_blacklist_entry' if is_blacklist else 'phone_whitelist.delete_entry' %}
{% set preview_endpoint = 'phone_whitelist.blacklist_import_preview' if is_blacklist else 'phone_whitelist.import_preview' %}
{% set apply_endpoint = 'phone_whitelist.blacklist_import_apply' if is_blacklist else 'phone_whitelist.import_apply' %}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div>
    <h1 class="h3 mb-1">📞 着信リスト管理</h1>
    <p class="text-muted mb-0">ブラックリストを最優先し、該当番号は応答前に即時拒否します。</p>
  </div>
  <div class="d-flex gap-2">
    <a class="btn btn-outline-secondary" href="{{ url_for('phone_diagnostics.index') }}">通話品質診断</a>
    <a class="btn btn-outline-success" href="{{ url_for(export_endpoint) }}">{{ list_name }}CSV書き出し</a>
    <form method="post" action="{{ url_for('phone_whitelist.sync_now') }}" onsubmit="return confirm('現在の全件をFreePBXへ再反映しますか？');">
      <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
      <button class="btn btn-outline-primary" type="submit">全件を再反映</button>
    </form>
  </div>
</div>

{% for category, message in get_flashed_messages(with_categories=true) %}
  <div class="alert alert-{{ category }} alert-dismissible fade show" role="alert">
    {{ message }}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="閉じる"></button>
  </div>
{% endfor %}

<div class="alert alert-light border d-flex flex-wrap gap-4 py-2">
  <span><strong>ホワイトリスト:</strong> {{ sync_state.entry_count or 0 }}件</span>
  <span><strong>ブラックリスト:</strong> {{ sync_state.blacklist_count or 0 }}件</span>
  <span><strong>最終反映:</strong> {{ sync_state.last_synced_at or '未反映' }}</span>
  <span><strong>操作者:</strong> {{ sync_state.updated_by or '-' }}</span>
  <span><strong>結果:</strong> {{ sync_state.last_result or '-' }}</span>
</div>

<ul class="nav nav-tabs mb-4">
  <li class="nav-item">
    <a class="nav-link {% if not is_blacklist %}active{% endif %}" href="{{ url_for('phone_whitelist.index') }}">ホワイトリスト</a>
  </li>
  <li class="nav-item">
    <a class="nav-link text-danger {% if is_blacklist %}active fw-bold{% endif %}" href="{{ url_for('phone_whitelist.index', list='blacklist') }}">ブラックリスト</a>
  </li>
</ul>

{% if is_blacklist %}
<div class="alert alert-danger">
  ここに登録した番号は、一時設定やホワイトリストより優先して呼出音なしで即時拒否します。Discord通知・留守電接続は行いません。
</div>
{% endif %}

<div class="row g-3 mb-4">
  <div class="col-lg-4">
    <section class="card h-100 {% if sync_state.anonymous_hangup_enabled %}border-danger{% endif %}">
      <div class="card-body">
        <form method="post" action="{{ url_for('phone_whitelist.update_setting') }}" onsubmit="return confirm('非通知着信の常時拒否設定を変更しますか？');">
          <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
          <input type="hidden" name="setting" value="anonymous_hangup">
          <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" role="switch" id="anonymousHangup" name="enabled" value="1" {% if sync_state.anonymous_hangup_enabled %}checked{% endif %}>
            <label class="form-check-label fw-bold" for="anonymousHangup">非通知を常にHangup(21)</label>
          </div>
          <p class="small text-muted">ONの間、非通知・通知不能の着信はDiscord通知や留守電接続を行わず、呼出音なしで即時拒否します。</p>
          <button class="btn btn-sm btn-danger" type="submit">設定を反映</button>
          {% if sync_state.anonymous_hangup_enabled %}
            <div class="mt-2 small text-danger fw-bold">現在ON：手動でOFFにするまで継続</div>
          {% endif %}
        </form>
      </div>
    </section>
  </div>
  <div class="col-lg-4">
    <section class="card h-100 {% if sync_state.anonymous_allowed_active %}border-warning{% endif %}">
      <div class="card-body">
        <form method="post" action="{{ url_for('phone_whitelist.update_setting') }}" onsubmit="return confirm('非通知着信の許可設定を変更しますか？');">
          <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
          <input type="hidden" name="setting" value="anonymous_allowed">
          <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" role="switch" id="anonymousAllowed" name="enabled" value="1" {% if sync_state.anonymous_allowed_active %}checked{% endif %} {% if sync_state.anonymous_hangup_enabled %}disabled{% endif %}>
            <label class="form-check-label fw-bold" for="anonymousAllowed">非通知着信を許可</label>
          </div>
          <p class="small text-muted">ONの間、非通知・通知不能の着信をRing Group 106へ接続します。</p>
          {% if sync_state.anonymous_hangup_enabled %}
            <div class="alert alert-danger small py-2">「非通知を常にHangup(21)」がONのため、強制OFFになっています。</div>
          {% endif %}
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <select class="form-select form-select-sm" name="duration" style="max-width:180px" {% if sync_state.anonymous_hangup_enabled %}disabled{% endif %}>
              <option value="900">15分</option><option value="1800">30分</option>
              <option value="3600" selected>1時間</option><option value="10800">3時間</option>
              <option value="manual">手動で戻すまで</option>
            </select>
            <button class="btn btn-sm btn-warning" type="submit" {% if sync_state.anonymous_hangup_enabled %}disabled{% endif %}>設定を反映</button>
          </div>
          {% if sync_state.anonymous_allowed_active %}
            <div class="mt-2 small text-warning-emphasis">現在ON：{% if sync_state.anonymous_allowed_manual %}手動解除まで{% else %}{{ sync_state.anonymous_allowed_until }}まで{% endif %}</div>
          {% endif %}
        </form>
      </div>
    </section>
  </div>
  <div class="col-lg-4">
    <section class="card h-100 {% if sync_state.whitelist_disabled_active %}border-danger{% endif %}">
      <div class="card-body">
        <form method="post" action="{{ url_for('phone_whitelist.update_setting') }}" onsubmit="return confirm('ホワイトリスト無効化設定を変更しますか？ ブラックリスト以外の番号通知あり着信を許可します。');">
          <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
          <input type="hidden" name="setting" value="whitelist_disabled">
          <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" role="switch" id="whitelistDisabled" name="enabled" value="1" {% if sync_state.whitelist_disabled_active %}checked{% endif %}>
            <label class="form-check-label fw-bold" for="whitelistDisabled">ホワイトリストを一時的に無効化</label>
          </div>
          <p class="small text-muted">ONの間、番号通知ありの着信はブラックリスト以外の登録・未登録をRing Group 106へ接続します。非通知の判定には影響しません。</p>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <select class="form-select form-select-sm" name="duration" style="max-width:180px">
              <option value="900">15分</option><option value="1800">30分</option>
              <option value="3600" selected>1時間</option><option value="10800">3時間</option>
              <option value="manual">手動で戻すまで</option>
            </select>
            <button class="btn btn-sm btn-danger" type="submit">設定を反映</button>
          </div>
          {% if sync_state.whitelist_disabled_active %}
            <div class="mt-2 small text-danger">現在ON：{% if sync_state.whitelist_disabled_manual %}手動解除まで{% else %}{{ sync_state.whitelist_disabled_until }}まで{% endif %}</div>
          {% endif %}
        </form>
      </div>
    </section>
  </div>
</div>

{% if preview_entries %}
<section class="card border-primary mb-4">
  <div class="card-header bg-primary text-white">CSV取込確認（{{ preview_entries|length }}件）</div>
  <div class="card-body">
    <p>同じ電話番号は名称・備考を更新し、CSVにない既存番号は削除しません。</p>
    <div class="table-responsive" style="max-height: 360px;">
      <table class="table table-sm table-striped align-middle">
        <thead class="table-light sticky-top"><tr><th>電話番号</th><th>名称</th><th>備考</th></tr></thead>
        <tbody>
          {% for entry in preview_entries %}
          <tr><td>{{ entry.phone_number }}</td><td>{{ entry.name }}</td><td>{{ entry.note }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="d-flex gap-2 mt-3">
      <form method="post" action="{{ url_for(apply_endpoint) }}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <input type="hidden" name="csv_payload" value="{{ csv_payload }}">
        <button class="btn {% if is_blacklist %}btn-danger{% else %}btn-primary{% endif %}" type="submit">この内容を{{ list_name }}へ登録・反映</button>
      </form>
      <a class="btn btn-outline-secondary" href="{{ url_for('phone_whitelist.index', list=list_type) }}">キャンセル</a>
    </div>
  </div>
</section>
{% endif %}

<div class="row g-3 mb-4">
  <div class="col-lg-7">
    <section class="card h-100">
      <div class="card-header">新規登録</div>
      <div class="card-body">
        <form method="post" action="{{ url_for(add_endpoint) }}" class="row g-2">
          <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
          <div class="col-md-4"><label class="form-label">電話番号</label><input class="form-control" name="phone_number" required maxlength="32" placeholder="08012345678"></div>
          <div class="col-md-4"><label class="form-label">名称</label><input class="form-control" name="name" maxlength="100"></div>
          <div class="col-md-4"><label class="form-label">備考</label><input class="form-control" name="note" maxlength="500"></div>
          <div class="col-12"><button class="btn {% if is_blacklist %}btn-danger{% else %}btn-primary{% endif %}" type="submit">{{ list_name }}へ登録して即時反映</button></div>
        </form>
      </div>
    </section>
  </div>
  <div class="col-lg-5">
    <section class="card h-100">
      <div class="card-header">CSV一括登録</div>
      <div class="card-body">
        <form method="post" action="{{ url_for(preview_endpoint) }}" enctype="multipart/form-data">
          <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
          <input class="form-control mb-2" type="file" name="csv_file" accept=".csv,text/csv" required>
          <div class="form-text mb-2">列: phone_number, name, note（UTF-8／Shift_JIS、最大1MB）</div>
          <button class="btn btn-outline-primary" type="submit">内容を確認</button>
        </form>
      </div>
    </section>
  </div>
</div>

<form class="row g-2 mb-3" method="get" action="{{ url_for('phone_whitelist.index') }}">
  <input type="hidden" name="list" value="{{ list_type }}">
  <div class="col-md-6"><input class="form-control" name="q" value="{{ query }}" placeholder="電話番号・名称・備考を検索"></div>
  <div class="col-auto"><button class="btn btn-outline-secondary" type="submit">検索</button></div>
  {% if query %}<div class="col-auto"><a class="btn btn-link" href="{{ url_for('phone_whitelist.index', list=list_type) }}">解除</a></div>{% endif %}
</form>

<div class="table-responsive">
  <table class="table table-bordered table-hover align-middle" style="min-width: 980px; table-layout: fixed;">
    <colgroup>
      <col style="width: 21%;">
      <col style="width: 24%;">
      <col style="width: 31%;">
      <col style="width: 24%;">
    </colgroup>
    <thead class="table-light"><tr><th>電話番号</th><th>名称</th><th>備考</th><th>操作</th></tr></thead>
    <tbody>
      {% for entry in entries %}
      <tr>
        <td class="p-2">
          <form id="phone-{{ list_type }}-entry-{{ entry.id }}" method="post" action="{{ url_for(edit_endpoint, entry_id=entry.id) }}">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <input class="form-control" name="phone_number" value="{{ entry.phone_number }}" required maxlength="32">
            {% if entry.phone_number in overlap_numbers %}<span class="badge text-bg-warning mt-1">両方に登録：ブラックリスト優先</span>{% endif %}
          </form>
        </td>
        <td class="p-2"><input class="form-control" form="phone-{{ list_type }}-entry-{{ entry.id }}" name="name" value="{{ entry.name }}" maxlength="100"></td>
        <td class="p-2"><input class="form-control" form="phone-{{ list_type }}-entry-{{ entry.id }}" name="note" value="{{ entry.note }}" maxlength="500"></td>
        <td class="p-2">
          <div class="d-flex flex-wrap gap-2">
            {% if not is_blacklist %}
            <button
              class="btn btn-sm btn-outline-success js-click-to-call"
              type="button"
              data-entry-id="{{ entry.id }}"
              data-phone-number="{{ entry.phone_number }}"
              data-name="{{ entry.name|e }}"
              {% if entry.phone_number in overlap_numbers %}disabled title="ブラックリスト登録中のため発信できません"{% endif %}
            >発信</button>
            {% endif %}
            <button class="btn btn-sm {% if is_blacklist %}btn-danger{% else %}btn-primary{% endif %} flex-grow-1" form="phone-{{ list_type }}-entry-{{ entry.id }}" type="submit">保存</button>
            <button class="btn btn-sm btn-outline-danger" form="phone-{{ list_type }}-entry-{{ entry.id }}" type="submit" formaction="{{ url_for(delete_endpoint, entry_id=entry.id) }}" onclick="return confirm('{{ entry.phone_number }} を{{ list_name }}から削除しますか？');">削除</button>
          </div>
        </td>
      </tr>
      {% else %}
      <tr><td colspan="4" class="text-center text-muted py-4">該当する電話番号はありません</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>

{% if not is_blacklist %}
<div class="modal fade" id="clickToCallModal" tabindex="-1" aria-labelledby="clickToCallModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <h2 class="modal-title h5 mb-1" id="clickToCallModalLabel">ホワイトリストから発信</h2>
          <div class="small text-muted" id="clickToCallTarget"></div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
      </div>
      <div class="modal-body">
        <div id="clickToCallControls">
          <label class="form-label" for="clickToCallEndpoint">どの電話機で話しますか？</label>
          <select class="form-select mb-3" id="clickToCallEndpoint">
            {% for endpoint, label in click_to_call_endpoints.items() %}
            <option value="{{ endpoint }}">{{ endpoint }} — {{ label }}</option>
            {% endfor %}
          </select>

          <label class="form-label" for="clickToCallTrunk">どの回線で外線発信しますか？</label>
          <select class="form-select mb-3" id="clickToCallTrunk">
            {% for key, trunk in click_to_call_trunks.items() %}
            <option value="{{ key }}" {% if not trunk.available %}disabled{% endif %}>
              {{ trunk.name }}{% if not trunk.available %} — 利用不可{% endif %}
            </option>
            {% endfor %}
          </select>

          <div class="alert alert-light border small mb-0">
            選択した電話機には <strong>外線発信 &lt;10321&gt;</strong> と表示して先に呼び出します。
            応答後に相手先へ発信します。相手側には契約回線の正規の発信者番号が通知されます。
          </div>
        </div>
        <div class="alert mt-3 mb-0 d-none" id="clickToCallStatus" role="status"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">閉じる</button>
        <button type="button" class="btn btn-success" id="clickToCallStart">この内容で発信</button>
      </div>
    </div>
  </div>
</div>

<script>
(() => {
  const modalElement = document.getElementById('clickToCallModal');
  const startButton = document.getElementById('clickToCallStart');
  const targetElement = document.getElementById('clickToCallTarget');
  const statusElement = document.getElementById('clickToCallStatus');
  const endpointElement = document.getElementById('clickToCallEndpoint');
  const trunkElement = document.getElementById('clickToCallTrunk');
  const csrfToken = {{ csrf_token()|tojson }};
  const startUrl = {{ url_for('phone_whitelist.click_to_call_start')|tojson }};
  const statusUrlTemplate = {{ url_for('phone_whitelist.click_to_call_status', job_id='JOB_ID')|tojson }};
  const statusLabels = {{ click_to_call_status_labels|tojson }};
  let selectedEntry = null;
  let pollTimer = null;

  function showStatus(status, detail = '', isError = false) {
    statusElement.className = `alert mt-3 mb-0 ${isError ? 'alert-danger' : 'alert-info'}`;
    statusElement.textContent = detail ? `${statusLabels[status] || status}：${detail}` : (statusLabels[status] || status);
  }

  function stopPolling() {
    if (pollTimer) window.clearTimeout(pollTimer);
    pollTimer = null;
  }

  async function readApiResponse(response) {
    const text = await response.text();
    if (text) {
      try {
        return JSON.parse(text);
      } catch (_) {
        // リバースプロキシが4xx/5xxをHTMLへ差し替えた場合も、利用者向けに日本語で表示する。
      }
    }
    const fallbackMessages = {
      400: '入力内容または認証情報を確認してください',
      403: '操作権限またはセッションを確認してください',
      404: '発信情報が見つかりません。画面を再読み込みしてください',
      409: '選択した電話機で別の発信処理が進行中、または発信できない番号です',
      503: 'FreePBXへ接続できませんでした',
    };
    return {
      ok: false,
      message: fallbackMessages[response.status] || `サーバーエラーが発生しました（HTTP ${response.status}）`,
    };
  }

  async function pollStatus(jobId) {
    try {
      const response = await fetch(statusUrlTemplate.replace('JOB_ID', jobId), {
        headers: {'Accept': 'application/json'},
        credentials: 'same-origin',
      });
      const data = await readApiResponse(response);
      if (!response.ok || !data.ok) throw new Error(data.message || '状態を確認できませんでした');
      showStatus(data.job.status, data.job.detail || '', ['failed', 'phone_no_answer', 'external_failed'].includes(data.job.status));
      if (data.job.terminal) {
        startButton.disabled = false;
        startButton.textContent = 'もう一度発信';
        return;
      }
      pollTimer = window.setTimeout(() => pollStatus(jobId), 1000);
    } catch (error) {
      showStatus('failed', error.message || String(error), true);
      startButton.disabled = false;
    }
  }

  document.querySelectorAll('.js-click-to-call').forEach(button => {
    button.addEventListener('click', () => {
      stopPolling();
      selectedEntry = {
        id: Number(button.dataset.entryId),
        phoneNumber: button.dataset.phoneNumber,
        name: button.dataset.name || '',
      };
      targetElement.textContent = `${selectedEntry.phoneNumber}${selectedEntry.name ? ` — ${selectedEntry.name}` : ''}`;
      statusElement.className = 'alert mt-3 mb-0 d-none';
      statusElement.textContent = '';
      startButton.disabled = false;
      startButton.textContent = 'この内容で発信';
      bootstrap.Modal.getOrCreateInstance(modalElement).show();
    });
  });

  startButton.addEventListener('click', async () => {
    if (!selectedEntry) return;
    const endpointText = endpointElement.options[endpointElement.selectedIndex].text;
    const trunkText = trunkElement.options[trunkElement.selectedIndex].text;
    if (!window.confirm(
      `${selectedEntry.phoneNumber} へ発信します。\n\n電話機: ${endpointText}\n外線: ${trunkText}\n\nよろしいですか？`
    )) return;
    stopPolling();
    startButton.disabled = true;
    startButton.textContent = '発信処理中…';
    showStatus('queued');
    try {
      const response = await fetch(startUrl, {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-Token': csrfToken},
        credentials: 'same-origin',
        body: JSON.stringify({
          entry_id: selectedEntry.id,
          endpoint: endpointElement.value,
          trunk: trunkElement.value,
        }),
      });
      const data = await readApiResponse(response);
      if (!response.ok || !data.ok) throw new Error(data.message || '発信を開始できませんでした');
      showStatus(data.status);
      pollStatus(data.job_id);
    } catch (error) {
      showStatus('failed', error.message || String(error), true);
      startButton.disabled = false;
      startButton.textContent = 'もう一度発信';
    }
  });

  modalElement.addEventListener('hidden.bs.modal', stopPolling);
})();
</script>
{% endif %}

{% if pages > 1 %}
<nav aria-label="ページ"><ul class="pagination">
  {% for number in range(1, pages + 1) %}
    <li class="page-item {% if number == page %}active{% endif %}"><a class="page-link" href="{{ url_for('phone_whitelist.index', list=list_type, q=query, page=number) }}">{{ number }}</a></li>
  {% endfor %}
</ul></nav>
{% endif %}
{% endblock %}
