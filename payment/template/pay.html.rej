   // ---------- Square 初期化 ----------
   async function main() {
     if (!window.Square) { showError('Square.jsの読み込みに失敗しました'); log('Square.js not found:', squareJsUrl); return; }
     let payments;
     try { payments = window.Square.payments(appId, locationId); log('Square.payments init OK'); }
     catch (e) { showError('appId/locationIdエラー: ' + (e?.message || e)); return; }
 
     // 初回 precheck（AUTOFILLを送る）
