-        body: JSON.stringify({ nickname: nickname || '（未設定）', x_id, instagram_id }) });
+        body: JSON.stringify({ nickname: nickname || '（未設定）', x_id, instagram_id, payment_token: paymentToken }) });
       const pj = await pre.json().catch(()=>({}));
       if (pre.ok && pj && pj.amount_yen) setAmount(pj.amount_yen); else setAmount(0);
     }catch(e){ setAmount(0); }
 
     // カード欄
     try{
       const card = await payments.card();
       await card.attach('#card-container');
       setupCardFlow(card);
     }catch(e){ log('card.attach FAILED:', e); }
 
     // Google Pay
     initGooglePay(payments);
 
     // Apple Pay
     initApplePay_NoAttach(payments);
 
     switchSection();
     sizeWalletButtons();
     window.addEventListener('resize', sizeWalletButtons);
   }
 
