[Unit]
Description=MFU Tokyo Disney Resort information refresh
After=network-online.target mysql.service mfu.service
Wants=network-online.target
StartLimitIntervalSec=3h
StartLimitBurst=3

[Service]
Type=oneshot
User=mfu
Group=mfu
WorkingDirectory=/mnt/mfu
Environment=PYTHONUNBUFFERED=1
ExecStart=/mnt/mfu/venv/bin/python -m app.tdr.update_cli --source popcorn
TimeoutStartSec=4min
Restart=on-failure
RestartSec=30min
NoNewPrivileges=yes
