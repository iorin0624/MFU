@@ -86,3 +87,5 @@
  same => n,TrySystem(/usr/bin/nohup /usr/bin/python3 /var/lib/asterisk/bin/mfu_blacklist_cdr.py '${NORMALIZED_CID}' '${MFU_BLACKLIST_NAME_B64}' '${MFU_CDR_DID}' '${MFU_CDR_ID}' </dev/null >/dev/null 2>&1 &)
  same => n,Hangup(21)
 ; END CALLER ID WHITELIST
