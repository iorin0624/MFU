[Unit]
Description=MFU Square managed payment reconciliation
After=network-online.target mfu.service
Wants=network-online.target

[Service]
Type=oneshot
User=mfu
Group=mfu
WorkingDirectory=/mnt/mfu
Environment=SQUARE_RECONCILE_ENABLED=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/mnt/mfu/venv/bin/python -m app.payment.reconcile_cli
NoNewPrivileges=yes

