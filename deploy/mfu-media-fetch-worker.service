[Unit]
Description=MFU image and video fetch worker
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=mfu
Group=mfu
WorkingDirectory=/mnt/mfu
Environment=PYTHONUNBUFFERED=1
Environment=TMPDIR=/mnt/mfu/tmp
ExecStart=/mnt/mfu/venv/bin/python -m app.image_viewer.media_fetch_worker
Restart=always
RestartSec=3
TimeoutStopSec=300
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
