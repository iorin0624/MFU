#!/usr/bin/env python3
from __future__ import annotations

import fcntl
import hashlib
import hmac
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import urllib.request
from pathlib import Path


STATE_DIR = Path("/var/lib/asterisk/mfu_call_through")
STATE_FILE = STATE_DIR / "current.json"
LOCK_FILE = STATE_DIR / ".lock"
GENERATED_CONF = Path("/etc/asterisk/mfu_call_through_generated.conf")
ENV_FILE = Path("/etc/asterisk/mfu-call-through.env")
TERMINAL = {"ended", "cancelled", "expired", "pin_failed", "target_blacklisted", "failed"}


def fail(message: str, code: int = 2) -> None:
    print(json.dumps({"ok": False, "error": message}, ensure_ascii=False))
    raise SystemExit(code)


def ensure_storage() -> None:
    STATE_DIR.mkdir(mode=0o750, parents=True, exist_ok=True)
    try:
        import grp
        import pwd
        uid = pwd.getpwnam("asterisk").pw_uid
        gid = grp.getgrnam("asterisk").gr_gid
        os.chown(STATE_DIR, uid, gid)
    except (KeyError, PermissionError):
        pass


def locked():
    ensure_storage()
    handle = LOCK_FILE.open("a+", encoding="utf-8")
    os.chmod(LOCK_FILE, 0o660)
    try:
        import grp
        import pwd
        os.chown(LOCK_FILE, pwd.getpwnam("asterisk").pw_uid, grp.getgrnam("asterisk").gr_gid)
    except (KeyError, PermissionError):
        pass
    fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
    return handle


def load_env() -> dict[str, str]:
    values: dict[str, str] = {}
    try:
        for line in ENV_FILE.read_text(encoding="utf-8").splitlines():
            if "=" in line and not line.lstrip().startswith("#"):
                key, value = line.split("=", 1)
                values[key.strip()] = value.strip()
    except OSError:
        pass
    return values


def read_state() -> dict:
    try:
        item = json.loads(STATE_FILE.read_text(encoding="utf-8"))
        return item if isinstance(item, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def atomic_write(path: Path, content: str, mode: int = 0o640) -> None:
    fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temp_name, mode)
        try:
            import grp
            import pwd
            os.chown(temp_name, pwd.getpwnam("asterisk").pw_uid, grp.getgrnam("asterisk").gr_gid)
        except (KeyError, PermissionError):
            pass
        os.replace(temp_name, path)
    finally:
        try:
            os.unlink(temp_name)
        except FileNotFoundError:
            pass


def write_state(item: dict) -> None:
    atomic_write(STATE_FILE, json.dumps(item, ensure_ascii=False, separators=(",", ":")) + "\n", 0o640)


def generated_content(item: dict | None) -> str:
    lines = ["; Generated by mfu-call-through. Do not edit.", "[mfu-call-through-reservation]"]
    if not item or item.get("status") != "active":
        lines.append("")
        return "\n".join(lines)
    source = item["allowed_phone_number"]
    lines.extend(
        [
            f"exten => {source},1,Set(MFU_CT_RESERVATION_ID={item['reservation_id']})",
            f" same => n,Set(MFU_CT_TARGET={item['target_phone_number']})",
            f" same => n,Set(MFU_CT_INBOUND_DID={item['inbound_did']})",
            f" same => n,Set(MFU_CT_OUTBOUND_TRUNK={item['outbound_trunk']})",
            f" same => n,Set(MFU_CT_OUTBOUND_TRUNK_ID={item['outbound_trunk_id']})",
            f" same => n,Set(MFU_CT_EXPIRES_AT={item['expires_at']})",
            " same => n,Return()",
            "",
        ]
    )
    return "\n".join(lines)


def install_generated(item: dict | None) -> None:
    GENERATED_CONF.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    atomic_write(GENERATED_CONF, generated_content(item), 0o640)
    result = subprocess.run(
        ["/usr/sbin/asterisk", "-rx", "dialplan reload"],
        text=True,
        capture_output=True,
        timeout=10,
        check=False,
    )
    if result.returncode != 0:
        fail((result.stderr or result.stdout or "dialplan reload failed").strip())


def spawn_notify(item: dict) -> None:
    with open(os.devnull, "rb") as devnull_in, open(os.devnull, "ab") as devnull_out:
        subprocess.Popen(
            [
                sys.executable, __file__, "notify", str(item["reservation_id"]),
                str(item["status"]), str(item.get("detail") or "")[:255],
            ],
            stdin=devnull_in,
            stdout=devnull_out,
            stderr=devnull_out,
            start_new_session=True,
            close_fds=True,
        )


def notify(reservation_id: str, status: str, detail: str) -> None:
    env = load_env()
    secret = env.get("PHONE_CALL_THROUGH_SECRET", "")
    url = env.get(
        "PHONE_CALL_THROUGH_CALLBACK_URL",
        "http://192.168.103.16:8080/internal/phone-call-through/status",
    )
    if not secret:
        return
    body = json.dumps(
        {"reservation_id": reservation_id, "status": status, "detail": detail[:255]},
        ensure_ascii=False,
        separators=(",", ":"),
    ).encode("utf-8")
    timestamp = str(int(time.time()))
    signature = hmac.new(
        secret.encode("utf-8"), timestamp.encode("ascii") + b"." + body, hashlib.sha256,
    ).hexdigest()
    request = urllib.request.Request(
        url,
        data=body,
        method="POST",
        headers={
            "Content-Type": "application/json",
            "X-MFU-Timestamp": timestamp,
            "X-MFU-Signature": signature,
        },
    )
    for attempt in range(3):
        try:
            with urllib.request.urlopen(request, timeout=4) as response:
                response.read(1024)
            return
        except Exception:
            if attempt < 2:
                time.sleep(0.5 * (attempt + 1))


def validate_reservation(reservation_id: str, payload: dict) -> dict:
    if str(payload.get("reservation_id") or "") != reservation_id:
        fail("reservation id mismatch")
    source = str(payload.get("allowed_phone_number") or "")
    target = str(payload.get("target_phone_number") or "")
    pin = str(payload.get("pin_code") or "")
    inbound_did = str(payload.get("inbound_did") or "")
    inbound_trunk = str(payload.get("inbound_trunk") or "")
    outbound_trunk = str(payload.get("outbound_trunk") or "")
    try:
        outbound_trunk_id = int(payload.get("outbound_trunk_id"))
        expires_at = int(payload.get("expires_at"))
    except (TypeError, ValueError):
        fail("invalid numeric value")
    if not re.fullmatch(r"0\d{9,10}", source) or not re.fullmatch(r"0\d{9,10}", target):
        fail("invalid phone number")
    if not re.fullmatch(r"\d{4}", pin):
        fail("invalid pin")
    if inbound_trunk != "brastel" or outbound_trunk != "brastel":
        fail("trunk unavailable")
    if inbound_did != "05068741025" or outbound_trunk_id != 3:
        fail("invalid trunk configuration")
    now = int(time.time())
    if expires_at <= now or expires_at > now + 600:
        fail("invalid expiry")
    return {
        "reservation_id": reservation_id,
        "allowed_phone_number": source,
        "target_phone_number": target,
        "inbound_trunk": inbound_trunk,
        "inbound_did": inbound_did,
        "outbound_trunk": outbound_trunk,
        "outbound_trunk_id": outbound_trunk_id,
        "pin_code": pin,
        "expires_at": expires_at,
        "status": "active",
        "detail": "",
        "created_at": now,
        "updated_at": now,
    }


def reserve(reservation_id: str) -> None:
    raw = sys.stdin.buffer.read(4097)
    if len(raw) > 4096:
        fail("payload too large")
    try:
        payload = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        fail("invalid payload")
    if not isinstance(payload, dict):
        fail("invalid payload")
    item = validate_reservation(reservation_id, payload)
    with locked():
        current = read_state()
        if (
            current.get("status") in {"active", "consumed", "connected"}
            and int(current.get("expires_at") or 0) > int(time.time())
        ):
            fail("another reservation is active")
        write_state(item)
        install_generated(item)
    print(json.dumps({"ok": True, "reservation_id": reservation_id, "status": "active"}))


def transition(
    reservation_id: str,
    status: str,
    detail: str = "",
    allowed_from: set[str] | None = None,
) -> dict:
    with locked():
        item = read_state()
        if item.get("reservation_id") != reservation_id:
            fail("reservation not found")
        current_status = str(item.get("status") or "")
        if current_status == status or current_status in TERMINAL:
            return item
        if allowed_from is not None and current_status not in allowed_from:
            return item
        item["status"] = status
        item["detail"] = detail[:255]
        item["updated_at"] = int(time.time())
        write_state(item)
        if status in TERMINAL or status == "consumed":
            install_generated(None)
    spawn_notify(item)
    return item


def authorize(reservation_id: str, entered_pin: str) -> None:
    if not re.fullmatch(r"\d{4}", entered_pin):
        fail("invalid pin", 3)
    expired_item: dict | None = None
    with locked():
        item = read_state()
        if item.get("reservation_id") != reservation_id or item.get("status") != "active":
            fail("reservation unavailable", 4)
        if int(item.get("expires_at") or 0) <= int(time.time()):
            item["status"] = "expired"
            item["detail"] = "reservation expired"
            item["updated_at"] = int(time.time())
            write_state(item)
            install_generated(None)
            expired_item = item
        elif not hmac.compare_digest(str(item.get("pin_code") or ""), entered_pin):
            fail("pin mismatch", 3)
        else:
            item["status"] = "consumed"
            item["detail"] = "PIN authenticated"
            item["updated_at"] = int(time.time())
            write_state(item)
            install_generated(None)
    if expired_item:
        spawn_notify(expired_item)
        fail("reservation expired", 4)
    spawn_notify(item)
    print(json.dumps({"ok": True, "reservation_id": reservation_id, "status": "consumed"}))


def cancel(reservation_id: str) -> None:
    item = transition(
        reservation_id, "cancelled", "cancelled by administrator", {"active"},
    )
    print(json.dumps({"ok": True, "reservation_id": reservation_id, "status": item["status"]}))


def invalidate(reservation_id: str, reason: str) -> None:
    status = reason if reason in {"pin_failed", "target_blacklisted"} else "failed"
    item = transition(reservation_id, status, reason, {"active"})
    print(json.dumps({"ok": True, "reservation_id": reservation_id, "status": item["status"]}))


def update_status(reservation_id: str, status: str, detail: str) -> None:
    if status not in {"connected", "ended"}:
        fail("invalid status")
    allowed_from = {"consumed"} if status == "connected" else {"consumed", "connected"}
    item = transition(reservation_id, status, detail, allowed_from)
    print(json.dumps({"ok": True, "reservation_id": reservation_id, "status": item["status"]}))


def main() -> None:
    if len(sys.argv) < 3:
        fail("usage: mfu-call-through action reservation_id [argument]")
    action = sys.argv[1]
    reservation_id = sys.argv[2]
    if not re.fullmatch(r"[a-f0-9]{32}", reservation_id):
        fail("invalid reservation id")
    if action == "reserve" and len(sys.argv) == 3:
        reserve(reservation_id)
    elif action == "cancel" and len(sys.argv) == 3:
        cancel(reservation_id)
    elif action == "authorize" and len(sys.argv) == 4:
        authorize(reservation_id, sys.argv[3])
    elif action == "invalidate" and len(sys.argv) == 4:
        invalidate(reservation_id, sys.argv[3])
    elif action == "status" and 4 <= len(sys.argv) <= 5:
        update_status(reservation_id, sys.argv[3], sys.argv[4] if len(sys.argv) == 5 else "")
    elif action == "notify" and len(sys.argv) == 5:
        notify(reservation_id, sys.argv[3], sys.argv[4])
    else:
        fail("invalid arguments")


if __name__ == "__main__":
    main()
