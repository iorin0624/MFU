# MFU SE02: copy to /etc/mfu/socketio.env (root:mfu, mode 0640).
# Existing /mnt/mfu/.env supplies SECRET_KEY and DB settings; do not copy
# credentials into this file. Verify the dedicated and HTTP processes load
# the same SECRET_KEY before enabling traffic.
MFU_SOCKETIO_DEDICATED=1
SOCKETIO_QUEUE_REQUIRED=1
SOCKETIO_MESSAGE_QUEUE=redis://127.0.0.1:6379/0
SOCKETIO_CORS_ALLOWED_ORIGINS=https://mfu.iori0624.jp
MYSQL_POOL_SIZE=5

# Also set SOCKETIO_QUEUE_REQUIRED=1 on the existing HTTP service only after
# Redis startup and a rollback rehearsal. Keep the same queue URL there.
