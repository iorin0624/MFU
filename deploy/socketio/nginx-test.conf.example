# Separate loopback-only test listener. Apache keeps its public 80/443.
# Place inside nginx http{} after nginx-socketio-common.conf.example.
# Test through an SSH tunnel and --resolve mfu.iori0624.jp:18443:127.0.0.1.
server {
    listen 127.0.0.1:18443 ssl;
    server_name mfu.iori0624.jp;
    ssl_certificate /etc/letsencrypt/live/iori0624.jp/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/iori0624.jp/privkey.pem;

    location ^~ /socket.io {
        proxy_pass http://192.168.103.16:8091;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $mfu_connection_upgrade;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 18443;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location / {
        proxy_pass https://127.0.0.1:443;
        proxy_ssl_server_name on;
        proxy_ssl_name mfu.iori0624.jp;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host mfu.iori0624.jp;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
