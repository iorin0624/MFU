# Illustrative delta ONLY, not a complete Apache configuration.
# Move every existing *:443 and [::]:443 vhost to loopback :8443 (not just
# MFU), and replace the old Listen 443 with Listen 127.0.0.1:8443.
# Clone the entire MFU :443 vhost onto 127.0.0.1:8444 for nginx's HTTP
# reverse proxy. This clone must retain all original MFU rewrite/location
# rules, logging exclusions, /dl/ routes, limits and certificate settings.
# All same-port vhosts must agree on RemoteIPProxyProtocol. Test every site.
# mod_remoteip is currently NOT enabled on the Pi; enable it before cutover.
Listen 127.0.0.1:8443
Listen 127.0.0.1:8444

# Existing vhost example, preserving its original directives and certificate:
# <VirtualHost 127.0.0.1:8443>
#     ServerName mail.iori0624.jp
#     RemoteIPProxyProtocol On
#     ... all original mail vhost directives ...
# </VirtualHost>
# <VirtualHost 127.0.0.1:8444>
#     ServerName mfu.iori0624.jp
#     RemoteIPHeader X-Forwarded-For
#     RemoteIPInternalProxy 127.0.0.1
#     ... a complete copy of the original MFU :443 vhost ...
# </VirtualHost>
# The :8444 clone never receives a PROXY header. Do not use
# RemoteIPProxyProtocolExceptions on :8443: it would disable parsing of
# nginx's PROXY header from loopback for every non-MFU site.
