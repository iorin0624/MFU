# nginx http{} context; include nginx-socketio-common.conf.example first.
# The stream listener delivers a PROXY header containing the real client IP.
server {
    listen 127.0.0.1:4443 ssl proxy_protocol;
    server_name mfu.iori0624.jp;
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
    ssl_certificate /etc/letsencrypt/live/iori0624.jp/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/iori0624.jp/privkey.pem;
    client_max_body_size 900m;
    large_client_header_buffers 4 16k;

    location ^~ /socket.io {
        proxy_pass http://192.168.103.16:8091;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $mfu_connection_upgrade;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # Apache continues to handle every non-Socket.IO MFU URL, including its
    # rewrite rules, maintenance page, upload limits and /dl/ handling.
    location / {
        proxy_pass https://127.0.0.1:8444;
        proxy_ssl_server_name on;
        proxy_ssl_name mfu.iori0624.jp;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host mfu.iori0624.jp;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_read_timeout 1200s;
        proxy_send_timeout 1200s;
        proxy_request_buffering off;
    }
}
