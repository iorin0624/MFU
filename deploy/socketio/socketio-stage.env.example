# Install at /etc/mfu/socketio-stage.env only after approval.
# No secrets in this example. Uses production app/.env by reference only.
MFU_SOCKETIO_DEDICATED=1
SOCKETIO_QUEUE_REQUIRED=1
SOCKETIO_MESSAGE_QUEUE=redis://127.0.0.1:6379/0
SOCKETIO_CORS_ALLOWED_ORIGINS=https://mfu.iori0624.jp
MYSQL_POOL_SIZE=3
# Do not set SOCKETIO_LOAD_TEST_TOKEN until a separate staging-only test is approved.
