[Unit]
Description=MFU Uber incremental activity fetch
After=network-online.target mysql.service mfu.service
Wants=network-online.target

[Service]
Type=oneshot
User=mfu
Group=mfu
WorkingDirectory=/mnt/mfu
Environment=PYTHONUNBUFFERED=1
ExecStart=/mnt/mfu/venv/bin/python -m app.records.uber_continuous_fetch_cli
TimeoutStartSec=20min
NoNewPrivileges=yes
