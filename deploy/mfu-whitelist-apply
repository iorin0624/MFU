#!/usr/bin/env bash
set -euo pipefail
umask 077

SOURCE=/etc/asterisk/caller_whitelist.txt
ACTION_TARGET=/etc/asterisk/caller_blacklist_actions_generated.conf
UPDATER=/usr/local/sbin/freepbx-whitelist-update
BACKUP_DIR=/var/backups/mfu-phone-whitelist
LOCK=/run/lock/mfu-whitelist-apply.lock
MAX_BYTES=524288
INPUT=$(mktemp)
OLD=$(mktemp)
ACTION_TMP=$(mktemp)
OLD_ACTION=$(mktemp)
HAD_OLD=0
HAD_OLD_ACTION=0
blacklist_disabled_until=0
trap 'rm -f "$INPUT" "$OLD" "$ACTION_TMP" "$OLD_ACTION"' EXIT

exec 8>"$LOCK"
flock -w 20 8 || { echo "ERROR another update is running" >&2; exit 1; }

dd of="$INPUT" bs=4096 count=129 status=none
SIZE=$(stat -c %s "$INPUT")
if (( SIZE > MAX_BYTES )); then
  echo "ERROR payload exceeds $MAX_BYTES bytes" >&2
  exit 1
fi

declare -A ACTIONS=()
while IFS= read -r raw || [[ -n "$raw" ]]; do
  raw=${raw%$'\r'}
  if [[ "$raw" == "# MFU_BLACKLIST_DISABLED_UNTIL="* ]]; then
    blacklist_disabled_until=${raw#*=}
    [[ "$blacklist_disabled_until" =~ ^[0-9]{1,12}$ ]] \
      || { echo "ERROR invalid blacklist disable expiry" >&2; exit 1; }
    continue
  fi
  [[ "$raw" == "# MFU_BLACKLIST_ACTION|"* ]] || continue
  IFS='|' read -r marker number action extra <<< "$raw"
  [[ "$marker" == "# MFU_BLACKLIST_ACTION" && -z "${extra:-}" ]] \
    || { echo "ERROR invalid blacklist action metadata" >&2; exit 1; }
  [[ "$number" =~ ^0[0-9]{9,10}$ ]] \
    || { echo "ERROR invalid blacklist action number" >&2; exit 1; }
  [[ "$action" =~ ^(hangup|ring_until_caller_hangup|ring_15|busy)$ ]] \
    || { echo "ERROR invalid blacklist action" >&2; exit 1; }
  ACTIONS[$number]="$action"
done < "$INPUT"

{
  echo '; Generated by /usr/local/sbin/mfu-whitelist-apply. Do not edit.'
  echo '[globals]'
  printf 'MFU_BLACKLIST_DISABLED_UNTIL=%s\n' "$blacklist_disabled_until"
  echo
  echo '[callerid-blacklist-actions]'
  for number in $(printf '%s\n' "${!ACTIONS[@]}" | sort); do
    printf 'exten => %s,1,Set(MFU_BLACKLIST_ACTION=%s)\n' "$number" "${ACTIONS[$number]}"
    echo ' same => n,Return()'
  done
} > "$ACTION_TMP"

install -d -o root -g root -m 0700 "$BACKUP_DIR"
if [[ -e "$SOURCE" ]]; then
  cp -a "$SOURCE" "$OLD"
  HAD_OLD=1
else
  printf '%s\n' '# Empty whitelist' > "$OLD"
fi
if [[ -e "$ACTION_TARGET" ]]; then
  cp -a "$ACTION_TARGET" "$OLD_ACTION"
  HAD_OLD_ACTION=1
fi

STAMP=$(date +%Y%m%d-%H%M%S)
cp -a "$OLD" "$BACKUP_DIR/caller_whitelist.$STAMP.txt"
install -o root -g asterisk -m 0640 "$INPUT" "$SOURCE"
install -o root -g asterisk -m 0640 "$ACTION_TMP" "$ACTION_TARGET"

if OUTPUT=$("$UPDATER" 2>&1); then
  WHITELIST_COUNT=$(grep -Ec '^[[:space:]]*[+]?[0-9]' "$SOURCE" || true)
  BLACKLIST_COUNT=$(grep -Ec '^B\|[+]?[0-9]' "$SOURCE" || true)
  logger -t mfu-whitelist "remote apply succeeded whitelist=$WHITELIST_COUNT blacklist=$BLACKLIST_COUNT"
  echo "OK whitelist=$WHITELIST_COUNT blacklist=$BLACKLIST_COUNT"
  exit 0
fi

if (( HAD_OLD )); then
  install -o root -g asterisk -m 0640 "$OLD" "$SOURCE"
else
  printf '%s\n' '# Empty whitelist' > "$SOURCE"
  chown root:asterisk "$SOURCE"
  chmod 0640 "$SOURCE"
fi
if (( HAD_OLD_ACTION )); then
  install -o root -g asterisk -m 0640 "$OLD_ACTION" "$ACTION_TARGET"
else
  rm -f "$ACTION_TARGET"
fi
if ! "$UPDATER" >/dev/null 2>&1; then
  logger -p auth.crit -t mfu-whitelist "apply failed and rollback reload failed"
fi
logger -p auth.warning -t mfu-whitelist "apply rejected: $OUTPUT"
echo "ERROR $OUTPUT" >&2
exit 1
